---
/**
 * Pilar 2 — Produção (maquiagem e penteado).
 *
 * Traz junto o MONTADOR: formatura e casamento se orçam por evento, não por
 * tabela, e a pergunta que trava a pessoa é "o que eu preciso informar?".
 * O montador faz as perguntas na tela e devolve a mensagem pronta.
 */
import { Image } from 'astro:assets';
import { site, producao, montagemProducao } from '../data/site';
import { img, Q_FOTO, Q_MINI, W_GRANDE, W_MEDIA, W_MINI } from '../lib/images';
import { wa } from '../lib/wa';

const foto = img(producao.imagem);
const destaque = img(producao.destaque.imagem);
const link = wa(
  site.whatsapp,
  'Olá! Vi o modelo de site e queria saber mais.',
);

const anoAtual = new Date().getFullYear();
const anos = Array.from({ length: montagemProducao.anosAFrente + 1 }, (_, i) => anoAtual + i);

const selectBase =
  'min-h-[52px] w-full appearance-none rounded-xl border border-linha bg-fundo pl-4 pr-11 text-[15px] text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento/60 focus:border-acento';
---

<section id="producao" data-secao-adiavel class="border-t border-linha bg-superficie py-24 lg:py-32">
  <div class="shell">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal data-centro-mobile class="max-w-xl">
        <p class="eyebrow">{producao.eyebrow}</p>
        <h2 class="mt-5 text-[clamp(2.3rem,6vw,3.8rem)] text-texto">{producao.titulo}</h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-texto-dim">{producao.texto}</p>

        <ul data-reveal-grupo class="mt-9 space-y-px overflow-hidden rounded-2xl border border-linha">
          {
            producao.itens.map((item) => (
              <li class="bg-fundo p-5 text-left transition-colors duration-[var(--dur-fast)] hover:bg-superficie-hi">
                <h3 class="text-[1.2rem] text-texto">{item.nome}</h3>
                <p class="mt-1 text-[15px] leading-relaxed text-texto-dim">{item.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        data-parallax-frame
        class="moldura-onda relative aspect-[4/5] overflow-hidden border border-linha lg:sticky lg:top-28"
      >
        <div class="h-full w-full">
          <div class="h-full w-full">
            <Image
              src={foto}
              alt={producao.alt}
              widths={W_MEDIA}
              quality={Q_FOTO}
              sizes="(min-width: 1024px) 44vw, 92vw"
              loading="lazy"
              data-parallax="4"
              class="parallax-folga object-cover"
            />
          </div>
        </div>
      </div>
    </div>

    {/* A foto larga em destaque — a única do bloco que mostra o penteado E o
        salão no mesmo quadro. */}
    <figure class="group relative mt-10 overflow-hidden rounded-[2rem] border border-linha">
      <div data-reveal-img class="aspect-[4/5] w-full sm:aspect-[16/9]">
        <div class="h-full w-full">
          <Image
            src={destaque}
            alt={producao.destaque.alt}
            widths={W_GRANDE}
            quality={Q_FOTO}
            sizes="(min-width: 1024px) 76rem, 92vw"
            loading="lazy"
            class="h-full w-full object-cover [@media(hover:hover)]:transition-transform [@media(hover:hover)]:duration-[var(--dur-slower)] [@media(hover:hover)]:ease-[var(--ease-out)] [@media(hover:hover)]:group-hover:scale-[1.03]"
          />
        </div>
      </div>
      <figcaption data-sobre-foto
                class="pointer-events-none absolute inset-x-0 bottom-0 veu-legenda px-6 pb-5 pt-16 text-[14px] tracking-wide text-creme">
        {producao.destaque.legenda}
      </figcaption>
    </figure>

    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        producao.galeria.map((g) => {
          const f = img(g.imagem);
          return (
            <figure class="group relative overflow-hidden rounded-2xl border border-linha">
              <div data-reveal-img class="aspect-[4/5] w-full">
                <div class="h-full w-full">
                  <Image
                    src={f}
                    alt={g.alt}
                    widths={W_MINI}
                    quality={Q_MINI}
                    sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw"
                    loading="lazy"
                    class="h-full w-full object-cover [@media(hover:hover)]:transition-transform [@media(hover:hover)]:duration-[var(--dur-slower)] [@media(hover:hover)]:ease-[var(--ease-out)] [@media(hover:hover)]:group-hover:scale-[1.05]"
                  />
                </div>
              </div>
              {g.legenda && (
                <figcaption data-sobre-foto
                class="pointer-events-none absolute inset-x-0 bottom-0 veu-legenda px-5 pb-4 pt-12 text-[13px] tracking-wide text-creme">
                  {g.legenda}
                </figcaption>
              )}
            </figure>
          );
        })
      }
    </div>

    {/* ── FERRAMENTA · Monte sua produção ────────────────────────────── */}
    <div
      data-reveal
      data-prod
      data-prod-whatsapp={site.whatsapp}
      data-prod-padrao="Olá! Vi o modelo de site e queria saber mais."
      class="mt-16 rounded-[2rem] border border-linha bg-fundo p-6 sm:p-9 lg:mt-24 lg:p-12"
    >
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div data-centro-mobile class="max-w-xl">
          <p class="eyebrow">Monte sua produção</p>
          <h3 class="mt-4 text-[clamp(1.8rem,4.5vw,2.6rem)] text-texto">
            Diga o que precisa e a mensagem sai pronta
          </h3>
          <p class="mt-4 text-[16px] leading-relaxed text-texto-dim">
            Sem preço aqui de propósito: produção se orça por evento. O que este quadro faz é
            garantir que a sua primeira mensagem já chegue com tudo o que eles precisam saber para
            responder um valor.
          </p>
        </div>
        <p
          data-prod-total
          data-tabular
          aria-live="polite"
          class="rounded-full border border-linha px-4 py-2 text-[13px] font-semibold text-acento"
        >
          1 pessoa
        </p>
      </div>

      <div class="mt-10 grid gap-9 lg:grid-cols-2">
        <fieldset>
          <legend class="text-sm font-semibold text-texto">Qual é a ocasião?</legend>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {
              montagemProducao.ocasioes.map((o) => (
                <label class="flex min-h-[48px] cursor-pointer items-center rounded-xl border border-linha bg-superficie px-4 text-[14.5px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento/12 has-[:checked]:font-semibold has-[:checked]:text-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                  <input type="radio" name="prod-ocasiao" value={o} data-prod-ocasiao class="sr-only" />
                  {o}
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-texto">O que você quer fazer?</legend>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {
              montagemProducao.servicos.map((s) => (
                <label class="flex min-h-[48px] cursor-pointer items-center rounded-xl border border-linha bg-superficie px-4 text-[14.5px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento/12 has-[:checked]:font-semibold has-[:checked]:text-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                  <input type="checkbox" value={s} data-prod-servico class="sr-only" />
                  {s}
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-texto">Vai mais alguém com você?</legend>
          <div class="mt-3 space-y-2.5">
            {
              montagemProducao.acompanhantes.map((g) => (
                <div
                  data-prod-grupo={g.id}
                  data-prod-max={g.max}
                  class="flex items-center justify-between gap-3 rounded-xl border border-linha bg-superficie px-4 py-2.5"
                >
                  <span class="text-[14.5px] text-texto-dim">{g.rotulo}</span>
                  <div class="flex items-center gap-1">
                    <button
                      type="button"
                      data-prod-menos
                      aria-label={`Menos ${g.rotulo.toLowerCase()}`}
                      class="grid h-11 w-11 place-items-center rounded-lg border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento"
                    >
                      −
                    </button>
                    <output
                      data-prod-valor
                      data-tabular
                      class="min-w-[2.5rem] text-center text-[16px] font-semibold text-texto"
                    >
                      0
                    </output>
                    <button
                      type="button"
                      data-prod-mais
                      aria-label={`Mais ${g.rotulo.toLowerCase()}`}
                      class="grid h-11 w-11 place-items-center rounded-lg border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento"
                    >
                      +
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
        </fieldset>

        <div>
          <p class="text-sm font-semibold text-texto">Quando é o evento?</p>
          <div class="mt-3 grid grid-cols-2 gap-2.5">
            <div class="relative">
              <label for="prod-mes" class="sr-only">Mês do evento</label>
              <select id="prod-mes" data-prod-mes class={selectBase}>
                <option value="">Mês</option>
                {/* O `value` é o NÚMERO do mês, não o nome. O formatador em
                    `ferramentas.ts` converte número → nome por extenso na
                    mão, justamente para não passar por `new Date()`: em fuso
                    negativo como o nosso, `new Date('2026-10')` é lido como
                    UTC e volta para setembro. */}
                {
                  montagemProducao.meses.map((m, i) => (
                    <option value={String(i + 1)}>{m}</option>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-texto-dim"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
            <div class="relative">
              <label for="prod-ano" class="sr-only">Ano do evento</label>
              <select id="prod-ano" data-prod-ano class={selectBase}>
                <option value="">Ano</option>
                {anos.map((a) => <option value={String(a)}>{a}</option>)}
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-texto-dim"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>

          <fieldset class="mt-5">
            <legend class="text-sm font-semibold text-texto">A que horas?</legend>
            <div class="mt-3 grid grid-cols-2 gap-2.5">
              {
                montagemProducao.horariosEvento.map((h) => (
                  <label class="flex min-h-[48px] cursor-pointer items-center justify-center rounded-xl border border-linha bg-superficie px-3 text-center text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento/12 has-[:checked]:font-semibold has-[:checked]:text-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                    <input type="radio" name="prod-hora" value={h} data-prod-hora class="sr-only" />
                    {h}
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>
      </div>

      {/* Prévia: a pessoa vê exatamente o que vai enviar antes de sair do
          site. Vazia até haver alguma escolha (`empty:hidden`). */}
      <div class="mt-9 border-t border-linha pt-7">
        <p
          data-prod-previa
          aria-live="polite"
          class="mb-4 whitespace-pre-line rounded-xl bg-superficie px-4 py-3 text-[14px] leading-relaxed text-texto-dim empty:hidden"
        >
        </p>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={link}
            data-prod-cta
            data-press
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[54px] flex-1 items-center justify-center gap-2.5 rounded-full bg-btn px-7 text-[15px] font-semibold text-btn-texto transition-colors duration-[var(--dur-fast)] hover:bg-acento-hi"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
              ></path>
            </svg>
            Enviar pelo WhatsApp
          </a>
          <button
            type="button"
            data-prod-limpar
            data-so-com-js
            class="inline-flex min-h-[48px] items-center justify-center rounded-full px-5 text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:text-texto"
          >
            Limpar
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
