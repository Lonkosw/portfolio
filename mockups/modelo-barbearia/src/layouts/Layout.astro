---
// Fraunces é variável nos eixos de peso, óptico e "wonk" — um arquivo só
// cobre todos os pesos que o site usa. Figtree idem.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { site, og } from '../data/site';
import { img } from '../lib/images';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/**
 * Prévia do link no WhatsApp — o canal real de distribuição deste site.
 *
 * ⚠️ NÃO É 1200x630 AQUI. O acervo desta pasta vem do Pexels em 1000px de
 * largura (teto medido em `mockups/README.md` — acima disso a primeira
 * visita engordava demais). Pedir 1200 de largura faria o Astro devolver um
 * arquivo menor que o anunciado, calado — número mentiroso, e o WhatsApp lê
 * esses números.
 *
 * 4:5 no tamanho que o arquivo realmente tem resolve isso. As medidas do
 * `<meta>` saem do que o `getImage` DEVOLVEU, nunca do que foi pedido — é o
 * que impede a mentira de voltar se alguém trocar a foto.
 */
const preview = await getImage({
  src: img(og.imagem),
  width: 800,
  height: 1000,
  fit: 'cover',
  format: 'jpg',
});
const previewUrl = new URL(preview.src, Astro.site ?? Astro.url).href;
const previewW = String(preview.attributes.width ?? preview.options.width);
const previewH = String(preview.attributes.height ?? preview.options.height);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

/**
 * ⚠️ ESTE MODELO NÃO TEM JSON-LD, DE PROPÓSITO.
 *
 * Os sites de cliente da pasta `sites/` publicam dados estruturados
 * (`HairSalon`, `BarberShop` etc.) — nome, telefone, endereço — e isso é
 * metade do argumento de venda contra "ter só Instagram". Aqui não dá: a
 * barbearia é fictícia, o endereço é "Rua da sua barbearia, 000" e o
 * telefone é placeholder.
 *
 * Dado estruturado é exatamente o tipo de coisa que máquina lê e acredita.
 * Publicar um bloco desses com endereço inventado seria plantar lixo, e a
 * página é `noindex` justamente para não ser lida — o bloco não teria nem
 * utilidade.
 *
 * Quando este modelo virar o site de um cliente real, o JSON-LD volta,
 * copiado de um site de cliente já publicado em `sites/`, com os dados
 * verdadeiros dele (tipo `BarberShop` no lugar de `HairSalon`).
 */
---

<html lang="pt-BR" class="js-anim">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Emenda com o topo da página. É o mesmo quase-preto do `--color-fundo` —
        qualquer outro valor cria uma faixa que não existe no site. */}
    <meta name="theme-color" content="#161210" />

    {/*
      Modelo demonstrativo NUNCA entra na busca. Além do motivo de sempre,
      há um específico aqui: uma "Barbearia Ferro" fictícia indexada poderia
      aparecer para quem procura barbearia e mandar a pessoa para um
      telefone que não existe.
    */}
    {site.demo && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={previewW} />
    <meta property="og:image:height" content={previewH} />
    <meta property="og:image:alt" content={site.descricao} />
    {/* `summary`, e não `summary_large_image`: a prévia é vertical, e o
        cartão largo esticaria uma foto de 600px numa faixa panorâmica. */}
    <meta name="twitter:card" content="summary" />

    
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Roda antes da pintura: sem JS ou com reduced-motion o conteúdo
      // nunca fica preso invisível (o CSS só esconde sob .js-anim).
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.remove('js-anim');
      }
      // Marca que há JS: os controles auxiliares só aparecem com ele.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-btn focus:px-5 focus:py-3 focus:font-medium focus:text-btn-texto"
    >
      Pular para o conteúdo
    </a>

    <slot />

    <script>
      import '../scripts/main';
    </script>

    <style is:global>
      /* Header ganha fundo sólido ao sair do topo. Transição nomeando as
         propriedades — nunca `transition: all`.

         SEM `backdrop-filter`: uma barra fixa da largura toda reprocessa o
         desfoque a cada quadro, com o site inteiro passando por baixo. É o
         item mais caro que uma página deste tipo costuma ter, e sobre um
         fundo liso a diferença visual é praticamente nula.

         O fundo é o `--color-fundo` escrito em rgb() literal, e não
         `var(...)`: esta regra vive num `<style is:global>`, fora do alcance
         do `@theme`. Ao mexer na base, mexer aqui junto. */
      [data-header] {
        transition:
          background-color var(--dur-base) var(--ease-standard),
          border-color var(--dur-base) var(--ease-standard),
          box-shadow var(--dur-base) var(--ease-standard);
      }
      [data-header].is-stuck {
        background-color: rgb(22 18 16 / 0.97);
        border-color: var(--color-linha);
        /* Sobre fundo escuro a sombra não separa nada — nada é mais escuro
           que a página. O que separa é a BORDA de baixo, que a linha acima
           acende. A sombra vira só uma vinheta de reforço, quase preta. */
        box-shadow: 0 1px 24px -12px rgb(0 0 0 / 0.6);
      }

      /* Leque do menu do celular: abre a partir do canto do botão.
         `visibility` entra na transição para o painel não ficar clicável
         enquanto está invisível — e ainda assim animar a saída. */
      [data-menu-panel] {
        transform-origin: top right;
        opacity: 0;
        transform: scale(0.96) translateY(-6px);
        visibility: hidden;
        pointer-events: none;
        transition:
          opacity var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-out),
          visibility var(--dur-base);
      }
      [data-menu-panel].is-open {
        opacity: 1;
        transform: none;
        visibility: visible;
        pointer-events: auto;
      }
      /* Saída mais rápida que a entrada: uma faixa abaixo na escala. */
      [data-menu-panel]:not(.is-open) {
        transition-duration: var(--dur-fast);
        transition-timing-function: var(--ease-in);
      }

      /* Feedback de toque. 0.97 é o piso: abaixo disso lê como exagero. */
      [data-press] {
        transition: transform var(--dur-fast) var(--ease-standard);
      }
      [data-press]:active {
        transform: scale(0.97);
      }
      @media (prefers-reduced-motion: reduce) {
        [data-press]:active {
          transform: none;
        }
      }
    </style>
  </body>
</html>
