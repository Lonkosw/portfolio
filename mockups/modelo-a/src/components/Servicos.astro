---
/**
 * Os quatro serviços.
 *
 * ⚠️ NÃO TEM PREÇO, e a ausência é o desenho. Um cartão de serviço com o
 * espaço do valor vazio grita "faltou preencher". Estes nunca tiveram linha
 * de valor: cada um termina numa conversa de WhatsApp com o assunto já
 * escrito, que é como o salão orça de verdade — coloração depende do
 * comprimento e do histórico químico do cabelo, e ninguém consegue dizer
 * isso por uma tabela.
 *
 * A FOTO É 4/5 e não 4/3. O acervo inteiro é retrato de celular; um recorte
 * horizontal comeria metade do comprimento do cabelo, que é exatamente o que
 * a foto de um salão precisa mostrar.
 */
import { Image } from 'astro:assets';
import { site, servicos } from '../data/site';
import { img, larguras } from '../lib/images';
import { wa } from '../lib/wa';
---

<section id="servicos" data-secao-adiavel class="border-t border-linha bg-fundo py-20 lg:py-28">
  <div class="shell">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{servicos.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2rem,7vw,3.2rem)] text-texto">{servicos.titulo}</h2>
      <p class="mt-5 text-[16px] leading-relaxed text-texto-dim">{servicos.texto}</p>
    </div>

    <div data-reveal-grupo class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-5">
      {
        servicos.itens.map((s) => {
          const foto = img(s.imagem);
          // A mensagem já nomeia o serviço: o salão recebe "quero fazer
          // mechas" em vez de "oi", que é a diferença entre uma conversa que
          // começa e uma que morre no primeiro turno.
          const link = wa(
            site.whatsapp,
            `Olá! Vim pelo site e gostaria de agendar ${s.nome.toLowerCase()}.`,
          );
          return (
            <a
              href={link}
              data-press
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col overflow-hidden rounded-xl border border-linha bg-superficie transition-colors duration-[var(--dur-fast)] hover:border-acento/60"
            >
              <div class="aspect-[4/5] w-full overflow-hidden">
                <Image
                  src={foto}
                  alt={s.alt}
                  widths={larguras(foto, [240, 360, 480])}
                  sizes="(min-width: 1024px) 23vw, (min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover object-center [@media(hover:hover)]:transition-transform [@media(hover:hover)]:duration-[var(--dur-slower)] [@media(hover:hover)]:ease-[var(--ease-out)] [@media(hover:hover)]:group-hover:scale-[1.04]"
                />
              </div>

              <div class="flex flex-1 flex-col p-5 lg:p-6">
                <h3 class="text-[1.3rem] leading-tight text-texto">{s.nome}</h3>
                <p class="mt-2.5 text-[14.5px] leading-relaxed text-texto-dim">{s.texto}</p>

                {/* `mt-auto` alinha o rodapé dos quatro cartões mesmo com
                    textos de alturas diferentes. */}
                <span class="mt-auto flex items-center gap-1.5 pt-5 text-[14px] font-semibold text-acento transition-colors duration-[var(--dur-fast)] group-hover:text-acento-hi">
                  Agendar
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
