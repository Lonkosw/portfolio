# Cabeçalhos da Netlify. Este arquivo é copiado para `dist/` no build e lido
# de lá — vale tanto para deploy pela UI quanto pelo CLI, sem depender de um
# `netlify.toml` na raiz.

# ── Assets com hash no nome ──────────────────────────────────────────────
# Tudo em /_astro/ leva um hash do conteúdo no nome do arquivo: mudou o
# conteúdo, muda o nome. Então o arquivo NUNCA precisa ser revalidado —
# `immutable` diz exatamente isso ao navegador, que para de mandar
# If-None-Match a cada visita.
#
# O padrão da Netlify para estes é bem mais curto, e era o que o Lighthouse
# apontava como "ciclos de vida de cache ineficientes".
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ── Vídeo ────────────────────────────────────────────────────────────────
# Não tem hash no nome (vem de `public/`), então um dia pode ser trocado no
# mesmo caminho. Uma semana, com revalidação.
/video/*
  Cache-Control: public, max-age=604800, must-revalidate

# ── HTML ─────────────────────────────────────────────────────────────────
# Sempre revalidado: é o arquivo que aponta para todos os outros. Se ele
# ficasse em cache, um deploy novo não chegaria em quem já visitou.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
