---
import { site } from '../data/site';
---

{
  site.demo && (
    <div class="border-b border-acento/25 bg-acento/10">
      <p class="shell py-2.5 text-center text-[13px] leading-snug text-texto-dim">
        <span class="font-semibold text-acento">Protótipo de demonstração.</span>{' '}
        Esta página não é o site oficial do {site.nome} — é uma proposta de como ele poderia ser.
      </p>
    </div>
  )
}
