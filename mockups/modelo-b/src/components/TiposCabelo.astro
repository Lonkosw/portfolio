---
/**
 * Carrossel de tipos de cabelo.
 *
 * POR QUE SCROLL-SNAP NATIVO E NÃO UMA BIBLIOTECA:
 * o navegador já sabe arrastar uma fila horizontal com inércia, respeitando
 * a velocidade do dedo e o modo de leitura da pessoa. Um carrossel de JS
 * reimplementa tudo isso pior, quebra o scroll do teclado, e some se o
 * script falhar. Aqui, sem JavaScript nenhum, a fila continua arrastável e
 * navegável por Tab — o script só acrescenta as setas do desktop.
 *
 * Cada cartão é um LINK para o WhatsApp com o tipo já escrito na mensagem.
 * É o pulo do gato da seção: a cliente não precisa saber dizer "morena
 * iluminada", ela aponta a foto.
 */
import { Image } from 'astro:assets';
import { site, tiposCabelo } from '../data/site';
import { img, Q_MINI, W_MINI } from '../lib/images';
import { wa } from '../lib/wa';
---

<section id="tipos" data-secao-adiavel data-tema="realce" class="border-t border-linha bg-fundo py-24 lg:py-32">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div data-reveal data-centro-mobile class="max-w-2xl">
        <p class="eyebrow">{tiposCabelo.eyebrow}</p>
        <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.4rem)] text-texto">{tiposCabelo.titulo}</h2>
        <p class="mt-5 text-[16.5px] leading-relaxed text-texto-dim">{tiposCabelo.texto}</p>
      </div>

      {/* Setas: conveniência de mouse, não o único meio de navegar. Some no
          celular, onde arrastar é mais rápido do que mirar num botão. */}
      <div data-carrossel-setas data-so-com-js class="hidden gap-2 lg:flex">
        {/* Nasce DESABILITADA no HTML: a fila sempre começa no início, então
            "voltar" não existe até alguém avançar. Sem isto a seta aparecia
            clicável até o script rodar e corrigir — um flash curto, mas é
            exatamente o tipo de coisa que faz o site parecer mal-acabado.
            O script cuida do resto a partir daqui. */}
        <button
          type="button"
          data-carrossel-anterior
          disabled
          aria-label="Ver os tipos anteriores"
          class="grid h-12 w-12 place-items-center rounded-full border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento disabled:opacity-40"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          data-carrossel-proximo
          aria-label="Ver os próximos tipos"
          class="grid h-12 w-12 place-items-center rounded-full border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento disabled:opacity-40"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/*
    A fila sai do `shell` de propósito e usa padding lateral próprio: assim a
    foto seguinte fica cortada pela borda da tela, o que é o que diz "tem
    mais para o lado". Uma fila que termina certinha na margem parece uma
    grade completa e ninguém arrasta.

    `scroll-pl-*` TEM de casar com o `px-*`. Sem ele, `snap-start` alinha o
    cartão à borda do contêiner ignorando o padding, e o navegador desloca a
    fila sozinho pelo tamanho exato do padding (40px no desktop) logo depois
    da carga: a seção abria com o primeiro cartão já cortado e a seta "voltar"
    habilitada sem nunca ter avançado.
  */}
  <div
    data-carrossel
    tabindex="0"
    role="group"
    aria-label="Tipos de cabelo — role para o lado para ver todos"
    class="mt-12 flex snap-x snap-mandatory scroll-pl-5 gap-4 overflow-x-auto scroll-smooth px-5 pb-4 [scrollbar-width:none] md:scroll-pl-10 md:px-10 [&::-webkit-scrollbar]:hidden"
  >
    {
      tiposCabelo.itens.map((item) => {
        const foto = img(item.imagem);
        const link = wa(
          site.whatsapp,
          `Olá! Vi o modelo de site. No meu salão eu gostaria de destacar: ${item.nome}.`,
        );
        return (
          <a
            href={link}
            data-carrossel-item
            data-press
            target="_blank"
            rel="noopener noreferrer"
            class="group relative w-[70vw] max-w-[280px] flex-none snap-start overflow-hidden rounded-[1.5rem] border border-linha sm:w-[46vw] lg:w-[calc((100%-3rem)/4)]"
          >
            <div class="aspect-[4/5] w-full overflow-hidden">
              <Image
                src={foto}
                alt={item.alt}
                widths={W_MINI}
                quality={Q_MINI}
                sizes="(min-width: 1024px) 22vw, (min-width: 640px) 46vw, 70vw"
                loading="lazy"
                class="h-full w-full object-cover [@media(hover:hover)]:transition-transform [@media(hover:hover)]:duration-[var(--dur-slower)] [@media(hover:hover)]:ease-[var(--ease-out)] [@media(hover:hover)]:group-hover:scale-[1.06]"
              />
            </div>

            {/* Piso de contraste sólido por baixo do gradiente: sozinho, o
                gradiente depende do quanto a foto é clara.

                O `pt` foi reduzido de 14 para 10 e a base de /80 para /70
                depois de ver as fotos reais no lugar: a faixa escura comia
                quase metade do cartão e o cabelo — que é o assunto — ficava
                espremido na parte de cima. O texto continua acima de 4.5:1. */}
            <div data-sobre-foto
                class="pointer-events-none absolute inset-x-0 bottom-0 veu-legenda px-5 pb-4 pt-12">
              <p class="text-[1.05rem] font-semibold text-creme">{item.nome}</p>
              <p class="mt-0.5 text-[13.5px] leading-snug text-creme/85">{item.texto}</p>
              {/* `text-acento`, e não um hex solto: esta seção roda em
                  `data-tema='realce'` e o acento de lá já é o caramelo
                  clareado. Um hex fixo aqui seria a única cor do cartão que
                  não acompanharia a paleta se ela mudar de novo. */}
              <p class="mt-2.5 flex items-center gap-1.5 text-[12.5px] font-semibold text-acento">
                Quero este
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </p>
            </div>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  /* O foco do teclado precisa aparecer na FILA quando ela é focada como
     região rolável — senão quem navega por Tab não sabe onde está. */
  [data-carrossel]:focus-visible {
    outline: 2px solid var(--color-acento);
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* `scroll-smooth` no contêiner faz as setas animarem, mas quem pediu menos
     movimento não quer a fila deslizando sozinha. */
  @media (prefers-reduced-motion: reduce) {
    [data-carrossel] {
      scroll-behavior: auto;
    }
  }
</style>
