---
import { Image } from 'astro:assets';
import { site, agendar, servicos } from '../data/site';
import { img } from '../lib/images';
import { wa } from '../lib/wa';

const foto = img(agendar.imagem);
const link = wa(site.whatsapp, agendar.mensagem);

/**
 * A frase de horário se monta a partir do array, seja ele de uma faixa ou de
 * cinco. Antes eram dois índices fixos (`horarios[0]` e `horarios[1]`) — o
 * Priorize tinha exatamente duas faixas e ninguém percebeu o acoplamento até
 * o Stilo, que divulga uma só, derrubar o build inteiro com
 * "Cannot read properties of undefined".
 *
 * Uma faixa  → "de segunda a sábado, 8h às 19h"
 * Duas       → "de segunda a sexta, 9h às 18h, e aos sábados, 9h às 13h"
 */
const faixasHorario = site.horarios
  .map((h) => `${h.dias.toLowerCase()}, ${h.horas}`)
  .reduce((acc, faixa, i, todas) => {
    if (i === 0) return faixa;
    return i === todas.length - 1 ? `${acc} e ${faixa}` : `${acc}, ${faixa}`;
  }, '');

const selectBase =
  'min-h-[52px] w-full appearance-none rounded-xl border border-linha bg-superficie pl-4 pr-11 text-[15px] text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento/60 focus:border-acento';
---

<section id="agendar" class="relative isolate overflow-hidden border-t border-linha bg-fundo">
  <div class="absolute inset-0 -z-10">
    <Image
      src={foto}
      alt={agendar.alt}
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-fundo/94"></div>
  </div>

  <div
    class="shell grid items-start gap-12 py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16 lg:py-32"
  >
    <div data-reveal data-centro-mobile class="max-w-xl lg:sticky lg:top-28">
      <p class="eyebrow">{agendar.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.4rem)] text-texto">{agendar.titulo}</h2>
      <p class="mt-5 text-[16.5px] leading-relaxed text-texto-dim">{agendar.texto}</p>

      <div class="mt-8 space-y-1">
        <p class="flex flex-wrap items-center gap-x-2 text-[15px] text-texto-dim">
          <span>Prefere ligar?</span>
          <a
            href={`tel:+${site.whatsapp}`}
            class="inline-flex min-h-[44px] items-center font-semibold text-acento underline decoration-acento/40 underline-offset-4 transition-colors duration-[var(--dur-fast)] hover:text-acento-hi"
          >
            {site.whatsappExibicao}
          </a>
        </p>
        {site.telefoneSecundario && (
          <p class="text-[14px] text-texto-dim">
            {`Segundo número: ${site.telefoneSecundario}`}
          </p>
        )}
      </div>
    </div>

    {/*
      ── FERRAMENTA 3 · Agendamento guiado ──────────────────────────────
      Sem backdrop-blur no painel: ele é grande e fica sobre a foto de fundo
      da seção, então o desfoque era recalculado durante todo o scroll. A
      opacidade a 92% dá a mesma separação e não custa camada de composição.
    */}
    <div
      data-reveal
      data-agenda
      data-agenda-whatsapp={site.whatsapp}
      data-agenda-padrao={agendar.mensagem}
      class="rounded-[2rem] border border-linha bg-fundo/92 p-6 sm:p-8"
    >
      <div class="grid gap-7">
        <div>
          <label for="agenda-servico" class="block text-sm font-semibold text-texto">
            O que você quer fazer?
          </label>
          <div class="relative mt-3">
            <select id="agenda-servico" data-agenda-servico class={selectBase}>
              <option value="">Escolha um serviço</option>
              {servicos.itens.map((s) => <option value={s.nome}>{s.nome}</option>)}
            </select>
            <svg
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-texto-dim"
              width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>

        <fieldset>
          <legend class="text-sm font-semibold text-texto">Que dia costuma dar certo?</legend>
          <div class="mt-3 grid grid-cols-3 gap-2.5 sm:grid-cols-6 lg:grid-cols-3">
            {
              agendar.dias.map((d) => (
                <label class="flex min-h-[48px] cursor-pointer items-center justify-center rounded-xl border border-linha bg-superficie px-2 text-center text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento/15 has-[:checked]:font-semibold has-[:checked]:text-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                  <input type="radio" name="agenda-dia" value={d} data-agenda-dia class="sr-only" />
                  {d.slice(0, 3)}
                  <span class="sr-only">{d}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-texto">Manhã ou tarde?</legend>
          <div class="mt-3 grid grid-cols-2 gap-3">
            {
              agendar.periodos.map((p) => (
                <label class="flex min-h-[52px] cursor-pointer items-center justify-center rounded-xl border border-linha bg-superficie px-4 text-[15px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento/15 has-[:checked]:font-semibold has-[:checked]:text-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                  <input type="radio" name="agenda-periodo" value={p} data-agenda-periodo class="sr-only" />
                  {p}
                </label>
              ))
            }
          </div>
          <p class="mt-3 text-[13px] text-texto-dim">
            {`Atendemos ${faixasHorario}.`}
          </p>
        </fieldset>

        {/* Prévia da mensagem: a pessoa vê exatamente o que vai enviar antes
            de sair do site. Vazia até haver alguma escolha. */}
        <div class="border-t border-linha pt-6">
          <p
            data-agenda-previa
            aria-live="polite"
            class="mb-4 whitespace-pre-line rounded-xl bg-superficie px-4 py-3 text-[14px] leading-relaxed text-texto-dim empty:hidden"
          >
          </p>

          <a
            href={link}
            data-agenda-cta
            data-press
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[56px] w-full items-center justify-center gap-2.5 rounded-xl bg-btn px-6 text-[15px] font-semibold text-btn-texto transition-colors duration-[var(--dur-fast)] hover:bg-cobre"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"></path>
            </svg>
            {agendar.cta}
          </a>

          <button
            type="button"
            data-agenda-limpar
            data-so-com-js
            class="mt-3 flex min-h-[44px] w-full items-center justify-center rounded-xl text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:text-texto"
          >
            Limpar
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
