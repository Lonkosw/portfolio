---
import { Image } from 'astro:assets';
import { casa } from '../data/site';
import { img } from '../lib/images';

const foto = img(casa.imagem);
---

<section id="casa" class="bg-fundo py-24 lg:py-32">
  <div class="shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-reveal data-centro-mobile class="max-w-xl">
      <p class="eyebrow">{casa.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.4rem)] text-texto">{casa.titulo}</h2>

      {
        casa.paragrafos.map((p) => (
          <p class="mt-5 text-[16.5px] leading-relaxed text-texto-dim">{p}</p>
        ))
      }

      {/*
        No Priorize este bloco eram as seis palavras da parede da recepção.
        Aqui não há parede escrita: o que o Stilo tem de próprio é o tempo.
        Por isso são números, e o primeiro deles é o ano.

        `numeral` e `data-tabular` alinham os dígitos — "1978" e "554" em
        fonte proporcional dançam de largura e o bloco fica torto.
      */}
      <dl data-reveal-grupo class="mt-9 grid grid-cols-3 gap-3 border-t border-linha pt-7">
        {
          casa.numeros.map((n) => (
            <div>
              <dt class="sr-only">{n.rotulo}</dt>
              <dd>
                <span
                  data-tabular
                  class="numeral block font-[family-name:var(--font-display)] text-[clamp(1.5rem,4.5vw,2.1rem)] leading-none text-acento"
                >
                  {n.valor}
                </span>
                <span class="mt-2 block text-[13px] leading-snug text-texto-dim">
                  {n.rotulo}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* Três níveis: a moldura recorta, o <div> recebe o transform do reveal
        e a <Image> recebe o do parallax. Dois transforms no mesmo nó se
        apagariam. */}
    <div
      data-parallax-frame
      class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-linha"
    >
      <div data-reveal-img class="h-full w-full">
        <div class="h-full w-full">
          <Image
            src={foto}
            alt={casa.alt}
            widths={[480, 720, 1080]}
            sizes="(min-width: 1024px) 44vw, 92vw"
            data-parallax="5"
            class="parallax-folga object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  {/* Duas fotos de apoio: a fachada prova o endereço que o texto acabou de
      afirmar. A segunda pode vir sem legenda — se a foto já disser sozinha,
      legendar é repetir. */}
  <div class="shell mt-8 grid gap-4 sm:grid-cols-2 lg:mt-10 lg:gap-5">
    {
      casa.galeria.map((g) => {
        const f = img(g.imagem);
        return (
          <figure class="group relative overflow-hidden rounded-2xl border border-linha">
            <div data-reveal-img class="aspect-[4/5] w-full sm:aspect-[3/4]">
              <div class="h-full w-full">
                <Image
                  src={f}
                  alt={g.alt}
                  widths={[420, 640, 900]}
                  sizes="(min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover [@media(hover:hover)]:transition-transform [@media(hover:hover)]:duration-[var(--dur-slower)] [@media(hover:hover)]:ease-[var(--ease-out)] [@media(hover:hover)]:group-hover:scale-[1.05]"
                />
              </div>
            </div>
            {g.legenda && (
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-fundo/75 bg-gradient-to-t from-fundo via-fundo/70 to-transparent px-5 pb-4 pt-12 text-[13px] tracking-wide text-texto">
                {g.legenda}
              </figcaption>
            )}
          </figure>
        );
      })
    }
  </div>
</section>
