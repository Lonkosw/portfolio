---
import { Image } from 'astro:assets';
import { site, reservar } from '../data/site';
import { img } from '../lib/images';
import { wa } from '../lib/wa';

const foto = img(reservar.imagem);
const link = wa(site.whatsapp, reservar.mensagem);

// Data mínima = hoje. Impede que a pessoa reserve para ontem — o erro mais
// comum em campo de data, e o navegador o resolve sozinho se a gente disser.
const hoje = new Date();
const minData = `${hoje.getFullYear()}-${String(hoje.getMonth() + 1).padStart(2, '0')}-${String(hoje.getDate()).padStart(2, '0')}`;

const rotuloBase =
  'flex min-h-[48px] cursor-pointer items-center justify-center rounded-full border border-linha bg-fundo px-5 text-center text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento has-[:checked]:font-semibold has-[:checked]:text-fundo has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento';
---

<section
  id="reservar"
  data-secao-adiavel
  class="relative isolate overflow-hidden border-t border-linha bg-fundo"
>
  <div class="absolute inset-0 -z-10">
    <Image
      src={foto}
      alt={reservar.alt}
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover object-center"
    />
    {/* Véu quase opaco: aqui a foto é textura, não assunto — o assunto é o
        formulário. Sem `backdrop-filter`: o custo não se justifica sobre
        um fundo que já é escuro. */}
    <div class="absolute inset-0 bg-fundo/[0.93]"></div>
  </div>

  <div class="shell grid items-start gap-14 py-24 lg:grid-cols-[1fr_1.15fr] lg:gap-20 lg:py-32">
    <div data-reveal data-centro-mobile class="max-w-xl lg:sticky lg:top-28">
      <p class="eyebrow">{reservar.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(2.3rem,6vw,3.9rem)] text-texto">{reservar.titulo}</h2>
      <p class="mt-6 text-[16.5px] leading-relaxed text-texto-dim">{reservar.texto}</p>

      <dl class="mt-10 space-y-5 border-t border-linha pt-8">
        {
          site.horarios.map((h) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <dt class="text-[15px] text-texto">{h.dias}</dt>
              <dd data-tabular class="text-[15px] text-texto-dim">{h.horas}</dd>
            </div>
          ))
        }
      </dl>

      {/* `inline-flex min-h-[44px]` no telefone: como link solto dentro de
          um parágrafo ele teria só a altura da linha (17px), e num celular
          é justamente o link que a pessoa tenta tocar com pressa. */}
      <p class="mt-8 flex flex-wrap items-center gap-x-2 text-[14px] leading-relaxed text-texto-dim">
        <span>Prefere falar direto?</span>
        <a
          href={`tel:+${site.whatsapp}`}
          class="inline-flex min-h-[44px] items-center font-semibold text-acento underline decoration-acento/30 underline-offset-4 transition-colors duration-[var(--dur-fast)] hover:text-acento-hi"
        >
          {site.whatsappExibicao}
        </a>
      </p>
    </div>

    {/* ── FERRAMENTA · Montador de reserva ──────────────────────────── */}
    <div
      data-reveal
      data-reserva
      data-reserva-whatsapp={site.whatsapp}
      data-reserva-padrao={reservar.mensagem}
      data-reserva-max={String(reservar.maxPessoas)}
      class="rounded-sm border border-linha bg-superficie/95 p-6 sm:p-9"
    >
      <div class="grid gap-8">
        {/* Quantas pessoas */}
        <div>
          <span class="block text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Quantas pessoas
          </span>
          <div
            data-res-pessoas
            class="mt-4 flex items-center gap-4"
          >
            <button
              type="button"
              data-res-menos
              data-so-com-js
              aria-label="Uma pessoa a menos"
              class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento disabled:opacity-40 disabled:hover:border-linha disabled:hover:text-texto"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14" stroke-linecap="round" />
              </svg>
            </button>
            <output
              data-res-pessoas-valor
              data-tabular
              aria-live="polite"
              aria-label="Número de pessoas"
              class="w-14 text-center font-[family-name:var(--font-display)] text-[2.4rem] leading-none text-texto"
            >
              2
            </output>
            <button
              type="button"
              data-res-mais
              data-so-com-js
              aria-label="Uma pessoa a mais"
              class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento disabled:opacity-40 disabled:hover:border-linha disabled:hover:text-texto"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round" />
              </svg>
            </button>
            <span class="text-[14px] text-texto-dim">
              {`até ${reservar.maxPessoas} — acima disso, fale com a gente`}
            </span>
          </div>
        </div>

        {/* Dia */}
        <div>
          <label
            for="res-data"
            class="block text-[13px] font-semibold uppercase tracking-[0.16em] text-acento"
          >
            Que dia
          </label>
          {/*
            `type="date"` nativo: o iOS e o Android abrem o seletor do
            próprio sistema, que é melhor do que qualquer calendário que eu
            escrevesse. O `min` impede reserva para ontem.
            `min-h-[52px]` e `text-[16px]` são obrigatórios: abaixo de 16px
            o Safari do iPhone dá zoom no campo ao focar.
          */}
          <input
            type="date"
            id="res-data"
            data-res-data
            min={minData}
            class="mt-4 min-h-[52px] w-full rounded-sm border border-linha bg-fundo px-4 text-[16px] text-texto [color-scheme:dark] transition-colors duration-[var(--dur-fast)] hover:border-acento/60 focus:border-acento"
          />
        </div>

        {/* Período */}
        <fieldset>
          <legend class="text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Almoço ou jantar
          </legend>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {
              reservar.periodos.map((p) => (
                <label class={rotuloBase}>
                  <input type="radio" name="res-periodo" value={p} data-res-periodo class="sr-only" />
                  {p}
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Horário */}
        <fieldset>
          <legend class="text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Por volta de que horas
          </legend>
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {
              reservar.horarios.map((h) => (
                <label class={rotuloBase}>
                  <input type="radio" name="res-horario" value={h} data-res-horario class="sr-only" />
                  <span data-tabular>{h}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Ocasião */}
        <fieldset>
          <legend class="text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            A ocasião <span class="font-normal normal-case tracking-normal text-texto-dim">(opcional)</span>
          </legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              reservar.ocasioes.map((o) => (
                <label class="flex min-h-[46px] cursor-pointer items-center rounded-full border border-linha bg-fundo px-5 text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento/15 has-[:checked]:font-semibold has-[:checked]:text-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                  <input type="radio" name="res-ocasiao" value={o} data-res-ocasiao class="sr-only" />
                  {o}
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Prévia + envio */}
        <div class="border-t border-linha pt-7">
          {/* A pessoa vê exatamente o que vai enviar antes de sair do site.
              `empty:hidden` some com a caixa enquanto não há escolha. */}
          <p
            data-res-previa
            aria-live="polite"
            class="mb-5 whitespace-pre-line rounded-sm bg-fundo px-4 py-4 text-[14px] leading-relaxed text-texto-dim empty:hidden"
          >
          </p>

          <a
            href={link}
            data-res-cta
            data-press
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[56px] w-full items-center justify-center gap-2.5 rounded-full bg-btn px-6 text-[15px] font-semibold tracking-wide text-btn-texto transition-colors duration-[var(--dur-fast)] hover:bg-vinho-hi"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"></path>
            </svg>
            {reservar.cta}
          </a>

          <button
            type="button"
            data-res-limpar
            data-so-com-js
            class="mt-3 flex min-h-[44px] w-full items-center justify-center rounded-full text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:text-texto"
          >
            Limpar
          </button>
        </div>
      </div>

      <p class="mt-8 text-center text-[12.5px] leading-relaxed text-texto-dim">
        Nada é enviado ao sair daqui: a mensagem é montada no seu próprio
        aparelho e só vai quando você tocar em enviar.
      </p>
    </div>
  </div>
</section>
