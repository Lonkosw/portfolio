---
import { site, nav, reservar } from '../data/site';
import { wa } from '../lib/wa';

const link = wa(site.whatsapp, reservar.mensagem);
---

{/*
  `sticky`, não `fixed`. Com `fixed` a barra sairia do fluxo e passaria
  por cima da faixa de protótipo que vem logo acima — e no celular as duas
  brigariam pelos mesmos 68px. Sticky deixa a faixa rolar e sumir, e o
  cabeçalho gruda no topo a partir daí, sem sobrepor nada.
*/}
<header
  data-header
  class="sticky top-0 z-50 border-b border-transparent"
>
  <div class="shell flex h-[68px] items-center justify-between gap-4 lg:h-[76px]">
    {/* A marca é um link para o topo — o comportamento que todo mundo
        espera de um logo, e que economiza uma linha no menu. */}
    {/* `-ml-1 px-1 py-3`: a marca é texto de 21px, e sem preenchimento o
        alvo teria 21px de altura. O padding leva a área de toque a 44px
        sem mover o logo um pixel — a margem negativa devolve o
        deslocamento que o padding causaria. */}
    <a
      href="#topo"
      class="-ml-1 flex min-h-[44px] shrink-0 items-center gap-[0.34em] px-1 text-[19px] leading-none lg:text-[21px]"
      aria-label={`${site.nome} — ir para o topo`}
    >
      <span class="font-[family-name:var(--font-display)] text-texto">Ana</span>
      <span class="font-[family-name:var(--font-display)] italic text-acento">Bistrô</span>
    </a>

    {/* `gap-4` + `px-3` em vez de `gap-8` sem padding: o espaço entre os
        itens vira área clicável em vez de vão morto, e cada link passa dos
        44px de largura sem que a barra fique mais larga. */}
    <nav aria-label="Navegação principal" class="hidden lg:block">
      <ul class="flex items-center gap-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="relative flex min-h-[44px] min-w-[44px] items-center justify-center px-3 text-[14px] tracking-wide text-texto-dim transition-colors duration-[var(--dur-fast)] hover:text-texto"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={link}
      data-press
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-full border border-acento/50 px-6 py-2.5 text-[13.5px] font-semibold tracking-wide text-acento transition-colors duration-[var(--dur-fast)] hover:border-acento hover:bg-acento hover:text-fundo lg:inline-block"
    >
      Reservar
    </a>

    {/* ── Menu do celular ─────────────────────────────────────────────
        Um botão só, que alterna. Com dois botões (abrir e fechar), o
        querySelector pega apenas o primeiro e o de fechar fica morto. */}
    <div class="relative lg:hidden">
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="grid h-11 w-11 place-items-center rounded-full border border-linha text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento"
      >
        <span data-menu-label class="sr-only">Abrir menu</span>
        <svg data-menu-icone="barras" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg data-menu-icone="x" hidden width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>

      <div
        id="menu-mobile"
        data-menu-panel
        class="absolute right-0 top-[calc(100%+0.6rem)] w-60 rounded-2xl border border-linha bg-superficie p-2 shadow-2xl shadow-black/60"
      >
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-[46px] items-center rounded-xl px-4 text-[15px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:bg-superficie-hi hover:text-texto"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={link}
          data-press
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 flex min-h-[48px] items-center justify-center rounded-xl bg-btn px-4 text-[15px] font-semibold text-btn-texto transition-colors duration-[var(--dur-fast)] hover:bg-vinho-hi"
        >
          Reservar
        </a>
      </div>
    </div>
  </div>
</header>
