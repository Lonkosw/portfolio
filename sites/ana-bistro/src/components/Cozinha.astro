---
import { Image } from 'astro:assets';
import { cozinha } from '../data/site';
import { img } from '../lib/images';
---

<section id="cozinha" data-secao-adiavel class="bg-fundo py-24 lg:py-32">
  <div class="shell">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{cozinha.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(2.3rem,6vw,3.9rem)] text-texto">{cozinha.titulo}</h2>
      <p class="mt-6 text-[16.5px] leading-relaxed text-texto-dim">{cozinha.texto}</p>
    </div>

    {/*
      Três pratos numa grade que vira coluna no celular. São exatamente 3
      itens numa grade de 3 colunas: uma linha cheia, sem vão.

      O desalinhamento vertical no desktop (`lg:mt-*` alternado) é
      deliberado: uma fileira perfeitamente alinhada de três fotos iguais
      lê como catálogo de e-commerce. Escalonar dá o ritmo de página de
      revista, que é o que a marca já usa nos impressos.
    */}
    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3 lg:gap-10">
      {
        cozinha.pratos.map((prato, i) => {
          const foto = img(prato.imagem);
          return (
            <figure
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
              class:list={['group', i === 1 ? 'lg:mt-14' : '', i === 2 ? 'lg:mt-28' : '']}
            >
              <div class="overflow-hidden rounded-sm border border-linha">
                <div data-reveal-img class="aspect-[4/5] w-full">
                  <div class="h-full w-full">
                    <Image
                      src={foto}
                      alt={prato.alt}
                      widths={[420, 640, 900]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                      loading="lazy"
                      class="h-full w-full object-cover [@media(hover:hover)]:transition-transform [@media(hover:hover)]:duration-[var(--dur-slower)] [@media(hover:hover)]:ease-[var(--ease-out)] [@media(hover:hover)]:group-hover:scale-[1.04]"
                    />
                  </div>
                </div>
              </div>

              <figcaption class="mt-5">
                <h3 class="text-[1.4rem] leading-snug text-texto">{prato.nome}</h3>
                <p class="mt-2 text-[14.5px] leading-relaxed text-texto-dim">{prato.texto}</p>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
