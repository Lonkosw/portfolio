---
import { agenda } from '../data/site';
---

<section data-secao-adiavel class="bg-fundo py-24 lg:py-32">
  <div class="shell">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{agenda.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(2.3rem,6vw,3.9rem)] text-texto">{agenda.titulo}</h2>
      <p class="mt-6 text-[16.5px] leading-relaxed text-texto-dim">{agenda.texto}</p>
    </div>

    {/* Três itens numa grade de 3: uma linha cheia, sem vão. */}
    <ul data-reveal-grupo class="mt-14 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-8">
      {
        agenda.itens.map((item) => (
          <li class="flex flex-col rounded-sm border border-linha bg-superficie p-8 transition-colors duration-[var(--dur-base)] hover:border-acento/40">
            <p class="text-[12px] uppercase tracking-[0.26em] text-acento">{item.dia}</p>
            <h3 class="mt-4 text-[1.5rem] leading-snug text-texto">{item.nome}</h3>
            <p class="mt-3 flex-1 text-[14.5px] leading-relaxed text-texto-dim">{item.texto}</p>
            {'nota' in item && item.nota && (
              <p
                data-tabular
                class="mt-5 border-t border-linha pt-4 text-[13px] leading-relaxed text-texto-dim"
              >
                {item.nota}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
