---
// Fraunces é variável nos eixos de peso, óptico e "wonk" — um arquivo só
// cobre todos os pesos que o site usa. Figtree idem.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/figtree';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { site, og } from '../data/site';
import { img } from '../lib/images';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/**
 * Prévia do link no WhatsApp — o canal real de distribuição deste site.
 *
 * ⚠️ NÃO É 1200x630 AQUI, e não por descuido. Esse é o recorte padrão e é o
 * que os outros sites da pasta usam, mas o acervo desta é todo retrato de
 * ~600px de largura (recortes de tela — ver `scripts/processar-fotos.py`).
 * Pedir 1200x630 dava dois problemas de uma vez: o Astro não faz upscale,
 * então o arquivo saía ~600px de largura enquanto o `<meta>` anunciava
 * 1200 — número mentiroso, e o WhatsApp lê esses números; e um corte
 * 1.91:1 numa foto vertical decepa a cabeça da pessoa.
 *
 * 4:5 no tamanho nativo resolve os dois. WhatsApp e Instagram renderizam
 * prévia vertical sem problema — o que eles não perdoam é dimensão
 * declarada diferente do arquivo.
 *
 * As medidas do `<meta>` saem do que o `getImage` DEVOLVEU, nunca do que
 * foi pedido. É o que impede a mentira de voltar se alguém trocar a foto.
 */
const preview = await getImage({
  src: img(og.imagem),
  width: 600,
  height: 750,
  fit: 'cover',
  format: 'jpg',
});
const previewUrl = new URL(preview.src, Astro.site ?? Astro.url).href;
const previewW = String(preview.attributes.width ?? preview.options.width);
const previewH = String(preview.attributes.height ?? preview.options.height);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

/**
 * Dados estruturados. É o que faz o Google entender cidade, telefone e tipo
 * de negócio — exatamente o argumento contra "ter só Instagram e um link
 * que leva ao WhatsApp".
 *
 * `HairSalon`, que é um tipo REAL do schema.org (herda de LocalBusiness) —
 * ao contrário de "fotógrafo", que não existe e obrigou o site da Joyce a
 * usar o genérico. Aqui o Google entende exatamente o que é o negócio.
 *
 * `telephone` recebe o FIXO e `contactPoint` o WhatsApp: o campo telephone
 * é o que aparece no cartão do Google, e ali um número que só recebe
 * mensagem faz a pessoa ligar e ninguém atender.
 *
 * Sem `priceRange`: eles não publicam valor, e inventar uma faixa aqui
 * contradiria o site inteiro.
 *
 * Sem `openingHours`: o horário de funcionamento não está publicado em
 * lugar nenhum. Chutar isso manda cliente à porta fechada.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.nomeCompleto,
  slogan: site.tagline,
  description: site.descricao,
  telephone: `+${site.telefone}`,
  url: canonical,
  image: previewUrl,
  areaServed: `${site.cidade} — ${site.estado}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.endereco,
    addressLocality: site.cidade,
    addressRegion: site.estado,
    addressCountry: 'BR',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'reservations',
    telephone: `+${site.whatsapp}`,
  },
  sameAs: [site.instagram],
};
---

<html lang="pt-BR" class="js-anim">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Emenda com o topo da página. É o mesmo quase-preto do `--color-fundo` —
        qualquer outro valor cria uma faixa que não existe no site. */}
    <meta name="theme-color" content="#12110f" />

    {/*
      Enquanto for protótipo, fora da busca. Sem isto o demo pode ranquear
      para "claus cabeleireiros maringá" e competir com os canais do próprio
      fotógrafa — atrapalhar o negócio dela antes da primeira conversa.
    */}
    {site.demo && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={previewW} />
    <meta property="og:image:height" content={previewH} />
    <meta property="og:image:alt" content={site.descricao} />
    {/* `summary`, e não `summary_large_image`: a prévia é vertical, e o
        cartão largo esticaria uma foto de 600px numa faixa panorâmica. */}
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Roda antes da pintura: sem JS ou com reduced-motion o conteúdo
      // nunca fica preso invisível (o CSS só esconde sob .js-anim).
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.remove('js-anim');
      }
      // Marca que há JS: os controles auxiliares só aparecem com ele.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-btn focus:px-5 focus:py-3 focus:font-medium focus:text-btn-texto"
    >
      Pular para o conteúdo
    </a>

    <slot />

    <script>
      import '../scripts/main';
    </script>

    <style is:global>
      /* Header ganha fundo sólido ao sair do topo. Transição nomeando as
         propriedades — nunca `transition: all`.

         SEM `backdrop-filter`: uma barra fixa da largura toda reprocessa o
         desfoque a cada quadro, com o site inteiro passando por baixo. É o
         item mais caro que uma página deste tipo costuma ter, e sobre um
         fundo liso a diferença visual é praticamente nula.

         O fundo é o `--color-fundo` escrito em rgb() literal, e não
         `var(...)`: esta regra vive num `<style is:global>`, fora do alcance
         do `@theme`. Ao mexer na base, mexer aqui junto. */
      [data-header] {
        transition:
          background-color var(--dur-base) var(--ease-standard),
          border-color var(--dur-base) var(--ease-standard),
          box-shadow var(--dur-base) var(--ease-standard);
      }
      [data-header].is-stuck {
        background-color: rgb(18 17 15 / 0.97);
        border-color: var(--color-linha);
        /* Sobre fundo escuro a sombra não separa nada — nada é mais escuro
           que a página. O que separa é a BORDA de baixo, que a linha acima
           acende. A sombra vira só uma vinheta de reforço, quase preta. */
        box-shadow: 0 1px 24px -12px rgb(0 0 0 / 0.6);
      }

      /* Leque do menu do celular: abre a partir do canto do botão.
         `visibility` entra na transição para o painel não ficar clicável
         enquanto está invisível — e ainda assim animar a saída. */
      [data-menu-panel] {
        transform-origin: top right;
        opacity: 0;
        transform: scale(0.96) translateY(-6px);
        visibility: hidden;
        pointer-events: none;
        transition:
          opacity var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-out),
          visibility var(--dur-base);
      }
      [data-menu-panel].is-open {
        opacity: 1;
        transform: none;
        visibility: visible;
        pointer-events: auto;
      }
      /* Saída mais rápida que a entrada: uma faixa abaixo na escala. */
      [data-menu-panel]:not(.is-open) {
        transition-duration: var(--dur-fast);
        transition-timing-function: var(--ease-in);
      }

      /* Feedback de toque. 0.97 é o piso: abaixo disso lê como exagero. */
      [data-press] {
        transition: transform var(--dur-fast) var(--ease-standard);
      }
      [data-press]:active {
        transform: scale(0.97);
      }
      @media (prefers-reduced-motion: reduce) {
        [data-press]:active {
          transform: none;
        }
      }
    </style>
  </body>
</html>
