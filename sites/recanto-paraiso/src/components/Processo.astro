---
import { processo } from '../data/site';
---

<section id="processo" class="border-t border-line/60 py-24 lg:py-32">
  <div class="shell">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{processo.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.5rem)] text-cream">{processo.titulo}</h2>
    </div>

    <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        processo.etapas.map((etapa, i) => (
          <li data-reveal data-reveal-delay={i * 0.07} class="relative">
            <span class="numeral text-[2.75rem]">{etapa.numero}</span>
            <span class="mt-4 block h-px w-full bg-line" aria-hidden="true" />
            <h3 class="mt-5 text-[1.5rem] text-cream">{etapa.titulo}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-cream-dim">{etapa.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
