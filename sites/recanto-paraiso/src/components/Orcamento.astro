---
import { Image } from 'astro:assets';
import { site, orcamento, simulador } from '../data/site';
import { img, larguras } from '../lib/images';
import { wa } from '../lib/wa';

const foto = img(orcamento.imagem);
/** href inicial; o simulador reescreve assim que o visitante escolhe algo. */
const link = wa(site.whatsapp, orcamento.mensagem);

// Anos calculados no build. Como o site é estático, um deploy novo em janeiro
// já traz a lista atualizada — não há ano velho preso no HTML por muito tempo.
const anoAtual = new Date().getFullYear();
const anos = Array.from({ length: simulador.anosAFrente + 1 }, (_, i) => anoAtual + i);

/** Classe comum dos <select>: o chevron vem do wrapper, não do navegador. */
const selectBase =
  'min-h-[52px] w-full appearance-none rounded-xl border border-line bg-surface pl-4 pr-11 text-[15px] text-cream transition-colors hover:border-cristal/60 focus:border-cristal';
---

<section id="orcamento" class="relative isolate overflow-hidden border-t border-line/60">
  <div class="absolute inset-0 -z-10">
    <Image
      src={foto}
      alt={orcamento.alt}
      widths={larguras(foto, [640, 1024])}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-mata/85"></div>
  </div>

  <div class="shell grid items-start gap-12 py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:py-32">
    <div data-reveal data-centro-mobile class="max-w-xl lg:sticky lg:top-28">
      <p class="eyebrow">{orcamento.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.5rem)] text-cream">{orcamento.titulo}</h2>
      <p class="mt-5 text-[16.5px] leading-relaxed text-cream-dim">{orcamento.texto}</p>

      <p class="mt-8 flex flex-wrap items-center gap-x-2 text-[15px] text-cream-dim lg:justify-start">
        <span>Prefere ligar?</span>
        <a
          href={`tel:+${site.whatsapp}`}
          class="inline-flex min-h-[44px] items-center text-cristal underline decoration-cristal/40 underline-offset-4 transition-colors hover:text-cristal-hi"
        >
          {site.whatsappExibicao}
        </a>
      </p>
    </div>

    {/* ── Simulador ──────────────────────────────────────────────────── */}
    <div
      data-reveal
      data-orc
      data-orc-whatsapp={site.whatsapp}
      data-orc-padrao={orcamento.mensagem}
      data-orc-convidados-padrao={simulador.convidadosPadrao}
      data-orc-min={simulador.convidadosMin}
      data-orc-max={simulador.convidadosMax}
      class="rounded-3xl border border-line bg-mata-soft/90 p-6 backdrop-blur-sm sm:p-8"
    >
      <div class="grid gap-7">
        {/* Tipo */}
        <div>
          <label for="orc-tipo" class="block text-sm font-medium text-cream">
            Que evento você vai fazer?
          </label>
          {/* `appearance-none` tira a setinha do sistema; sem repor uma, o
              campo fica igual a uma caixa de texto e ninguém percebe que abre. */}
          <div class="relative mt-3">
            <select id="orc-tipo" data-orc-tipo class={selectBase}>
              <option value="">Escolha uma opção</option>
              {simulador.tipos.map((t) => <option value={t}>{t}</option>)}
            </select>
            <svg
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-cream-dim"
              width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>

        {/* Convidados */}
        <div>
          <label for="orc-convidados" class="block text-sm font-medium text-cream">
            Quantos convidados?
          </label>
          <div class="mt-3 flex items-center gap-3">
            <button
              type="button"
              data-orc-menos
              data-so-com-js
              aria-label="Diminuir dez convidados"
              class="grid h-[52px] w-[52px] shrink-0 place-items-center rounded-xl border border-line text-cream transition-colors hover:border-cristal hover:text-cristal"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M5 12h14" stroke-linecap="round"></path>
              </svg>
            </button>

            <input
              id="orc-convidados"
              data-orc-convidados
              type="number"
              inputmode="numeric"
              min={simulador.convidadosMin}
              max={simulador.convidadosMax}
              step="1"
              value={simulador.convidadosPadrao}
              class="min-h-[52px] w-full rounded-xl border border-line bg-surface px-4 text-center text-[17px] font-medium text-cream transition-colors focus:border-cristal"
            />

            <button
              type="button"
              data-orc-mais
              data-so-com-js
              aria-label="Aumentar dez convidados"
              class="grid h-[52px] w-[52px] shrink-0 place-items-center rounded-xl border border-line text-cream transition-colors hover:border-cristal hover:text-cristal"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>
          <p class="mt-2 text-[13px] text-cream-dim/80">
            {`O salão comporta até ${simulador.convidadosMax} convidados sentados.`}
          </p>
        </div>

        {/*
          Data. Dois <select> em vez de <input type="month"> de propósito:
          o Safari do iPhone NÃO implementa `type=month` e degrada para campo
          de texto — a visitante teria que adivinhar e digitar "2026-10".
          Como a maioria vai abrir isto no celular, o campo nativo era o
          caminho mais curto para perder a pessoa.
        */}
        <div>
          <span class="block text-sm font-medium text-cream">Quando, mais ou menos?</span>
          <div class="mt-3 grid grid-cols-2 gap-3">
            <div class="relative">
              <label for="orc-mes" class="sr-only">Mês pretendido</label>
              <select id="orc-mes" data-orc-mes class={selectBase}>
                <option value="">Mês</option>
                {
                  simulador.meses.map((m, i) => (
                    <option value={String(i + 1).padStart(2, '0')}>
                      {m.charAt(0).toUpperCase() + m.slice(1)}
                    </option>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-cream-dim"
                width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>

            <div class="relative">
              <label for="orc-ano" class="sr-only">Ano pretendido</label>
              <select id="orc-ano" data-orc-ano class={selectBase}>
                <option value="">Ano</option>
                {anos.map((a) => <option value={String(a)}>{a}</option>)}
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-cream-dim"
                width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
          <p class="mt-2 text-[13px] text-cream-dim/80">
            Ainda não decidiu? Pode deixar em branco e combinar na conversa.
          </p>
        </div>

        {/*
          O <input> real é `sr-only` e o rótulo faz as vezes de botão. Sem o
          `has-[:focus-visible]` abaixo, o anel de foco do teclado seria
          desenhado no elemento invisível: quem navega por Tab não veria onde
          está. Foco fica no rótulo, que é o que a pessoa enxerga.
        */}
        <fieldset>
          <legend class="text-sm font-medium text-cream">Período</legend>
          <div class="mt-3 grid grid-cols-2 gap-3">
            {
              simulador.periodos.map((p) => (
                <label class="flex min-h-[52px] cursor-pointer items-center justify-center rounded-xl border border-line bg-surface px-4 text-[15px] text-cream-dim transition-colors hover:border-cristal/60 has-[:checked]:border-cristal has-[:checked]:bg-cristal/12 has-[:checked]:text-cream has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-cristal">
                  <input type="radio" name="orc-periodo" value={p} data-orc-periodo class="sr-only" />
                  {p}
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Já tenho */}
        <fieldset>
          <legend class="text-sm font-medium text-cream">Você já tem alguma coisa fechada?</legend>
          <div class="mt-3 flex flex-wrap gap-2.5">
            {
              simulador.jaTenho.map((item) => (
                <label class="flex min-h-[46px] cursor-pointer items-center rounded-full border border-line bg-surface px-5 text-[14.5px] text-cream-dim transition-colors hover:border-cristal/60 has-[:checked]:border-cristal has-[:checked]:bg-cristal/12 has-[:checked]:text-cream has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-cristal">
                  <input type="checkbox" value={item} data-orc-tenho class="sr-only" />
                  {item}
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Ações */}
        <div class="border-t border-line pt-6">
          <a
            href={link}
            data-wa-cta
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[56px] w-full items-center justify-center gap-2.5 rounded-xl bg-cristal px-6 text-[15px] font-medium text-mata transition-colors duration-300 hover:bg-cristal-hi"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"></path>
            </svg>
            {orcamento.cta}
          </a>

          <button
            type="button"
            data-orc-limpar
            data-so-com-js
            class="mt-3 flex min-h-[44px] w-full items-center justify-center rounded-xl text-[14px] text-cream-dim transition-colors hover:text-cream"
          >
            Limpar e começar de novo
          </button>

          <p class="mt-4 text-center text-[12.5px] leading-relaxed text-cream-dim/70">
            Nada é enviado ao sair daqui: a mensagem é montada no seu celular e
            só vai quando você tocar no botão.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
