---
import { marquee } from '../data/site';

// Duplicado para o loop de -50% fechar sem salto.
const trilha = [...marquee, ...marquee];
---

<section aria-hidden="true" class="overflow-hidden border-y border-line/70 py-5">
  <div class="marquee-track flex w-max items-center gap-10 whitespace-nowrap">
    {
      trilha.map((item) => (
        <span class="flex items-center gap-10 text-sm uppercase tracking-[0.24em] text-cream-dim">
          {item}
          <span class="h-1 w-1 rounded-full bg-cristal/70" />
        </span>
      ))
    }
  </div>
</section>
