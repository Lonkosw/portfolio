---
import { Image } from 'astro:assets';
import { eventos } from '../data/site';
import { img, larguras } from '../lib/images';
---

<section id="eventos" class="border-t border-line/60 py-24 lg:py-32">
  <div class="shell">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{eventos.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.5rem)] text-cream">{eventos.titulo}</h2>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        eventos.itens.map((item, i) => {
          const foto = img(item.imagem);
          return (
            <article
              data-reveal
              data-reveal-delay={i * 0.07}
              class="group overflow-hidden rounded-2xl border border-line bg-mata-soft"
            >
              <div class="aspect-[5/4] overflow-hidden">
                <Image
                  src={foto}
                  alt={item.alt}
                  widths={larguras(foto, [320, 480, 720])}
                  sizes="(min-width: 1024px) 23vw, (min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
                />
              </div>
              <div class="p-6">
                <h3 class="text-[1.5rem] text-cream">{item.nome}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-cream-dim">{item.texto}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
