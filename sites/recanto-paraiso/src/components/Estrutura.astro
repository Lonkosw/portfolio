---
import { estrutura } from '../data/site';
---

<section id="estrutura" class="border-t border-line/60 py-24 lg:py-32">
  <div class="shell">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{estrutura.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.5rem)] text-cream">{estrutura.titulo}</h2>
      <p class="mt-5 text-[16.5px] leading-relaxed text-cream-dim">{estrutura.texto}</p>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        estrutura.itens.map((item, i) => (
          <li
            data-reveal
            data-reveal-delay={(i % 3) * 0.08}
            class="bg-mata-soft p-7 transition-colors duration-300 hover:bg-surface lg:p-8"
          >
            <span
              class="numeral block text-[15px] tracking-[0.2em]"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-[1.45rem] text-cream">{item.nome}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-cream-dim">{item.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
