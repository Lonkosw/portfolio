---
import { Image } from 'astro:assets';
import { sobre } from '../data/site';
import { img, larguras } from '../lib/images';

const foto = img(sobre.imagem);
---

<section id="sobre" class="py-24 lg:py-32">
  <div class="shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-reveal data-centro-mobile class="max-w-xl">
      <p class="eyebrow">{sobre.eyebrow}</p>
      <h2 class="mt-5 text-[clamp(2.1rem,5.5vw,3.5rem)] text-cream">{sobre.titulo}</h2>

      {
        sobre.paragrafos.map((p) => (
          <p class="mt-5 text-[16.5px] leading-relaxed text-cream-dim">{p}</p>
        ))
      }

      <div class="mt-9 flex flex-wrap items-center gap-x-10 gap-y-6">
        {
          sobre.numeros.map((n) => (
            <div>
              <p class="numeral text-[clamp(2.5rem,7vw,3.5rem)]">
                <span data-count={n.valor}>{n.valor}</span>
                {n.sufixo}
              </p>
              <p class="mt-1 text-sm text-cream-dim">{n.label}</p>
            </div>
          ))
        }

        <p
          class="max-w-[15rem] border-l border-line pl-5 text-[15px] leading-snug text-cream lg:max-w-[13rem]"
        >
          {sobre.destaque}
        </p>
      </div>
    </div>

    {/*
      Três níveis: a moldura recorta, o <div> recebe o transform do reveal
      (escala de entrada) e a <Image> recebe o do parallax. Dois `transform`
      no mesmo nó se apagariam.
    */}
    <div
      data-parallax-frame
      class="relative aspect-[4/5] overflow-hidden rounded-3xl border border-line"
    >
      <div data-reveal-img class="h-full w-full">
        <div class="h-full w-full">
          <Image
            src={foto}
            alt={sobre.alt}
            widths={larguras(foto, [320, 480, 720])}
            sizes="(min-width: 1024px) 44vw, 92vw"
            data-parallax="5"
            class="parallax-folga object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
