---
/**
 * Calculadora de orçamento por m² — componente único, compartilhado pelas três páginas.
 * O visual muda pelo atributo data-variant (estilos em cada folha de estilo do modelo) e
 * pelas props de texto. A lógica fica em src/scripts/calculator.ts e src/lib/calc.ts.
 */
import Icon from './Icon.astro';
import {
  ALTURA_SAIA,
  AVISO_VALORES,
  BORDAS,
  CATEGORIAS,
  CUBAS,
  MATERIAIS,
  TIPOS_PECA,
} from '../data/marmoraria-config.ts';
import type { Variante } from '../data/types.ts';

interface Props {
  variante: Variante;
  eyebrow: string;
  titulo: string;
  subtitulo: string;
}
const { variante, eyebrow, titulo, subtitulo } = Astro.props;

const passos = ['Tipo de peça', 'Medidas', 'Material', 'Acabamentos', 'Instalação'];
const wizard = variante === 'acolhedor';
const moeda = (n: number) => n.toLocaleString('pt-BR');
---

<section id="calculadora" class="calc" data-calc data-variant={variante} data-wizard={wizard} aria-labelledby="calc-titulo">
  <div class="calc-wrap">
    <header class="calc-head" data-reveal>
      <p class="calc-eyebrow">{eyebrow}</p>
      <h2 id="calc-titulo" class="calc-title">{titulo}</h2>
      <p class="calc-sub">{subtitulo}</p>
    </header>

    {
      wizard && (
        <ol class="calc-progress" aria-label="Etapas do orçamento" data-calc-progress>
          {passos.map((p, i) => (
            <li>
              <button type="button" class="calc-progress-btn" data-goto={i} aria-current={i === 0 ? 'step' : undefined}>
                <span class="calc-progress-n">{i + 1}</span>
                <span class="calc-progress-t">{p}</span>
              </button>
            </li>
          ))}
        </ol>
      )
    }

    <div class="calc-grid">
      <form class="calc-form" data-calc-form novalidate onsubmit="return false">
        <!-- 1. TIPO -->
        <fieldset class="calc-step" data-step="0">
          <legend class="calc-legend"><span class="calc-legend-n">1</span>Tipo de peça</legend>
          <div class="calc-types" role="radiogroup" aria-label="Tipo de peça">
            {
              TIPOS_PECA.map((t, i) => (
                <label class="calc-type">
                  <input type="radio" name="tipo" value={t.id} checked={i === 0} class="sr-only" />
                  <span class="calc-type-card">
                    <Icon name={t.id} size={28} />
                    <span>{t.nome}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- 2. MEDIDAS -->
        <fieldset class="calc-step" data-step="1">
          <legend class="calc-legend"><span class="calc-legend-n">2</span>Medidas</legend>
          <div class="calc-measure">
            <div class="calc-fields">
              <div class="calc-field">
                <label for="calc-comp" data-lbl="comprimento">Comprimento (cm)</label>
                <input id="calc-comp" name="comprimento" type="number" inputmode="decimal" min="1" max="2000" step="1" value="250" />
              </div>
              <div class="calc-field" data-hide-for="escada">
                <label for="calc-larg" data-lbl="largura">Largura (cm)</label>
                <input id="calc-larg" name="largura" type="number" inputmode="decimal" min="1" max="1000" step="1" value="60" />
              </div>
              <div class="calc-field" data-show-for="escada" hidden>
                <label for="calc-degraus">Número de degraus</label>
                <input id="calc-degraus" name="degraus" type="number" inputmode="numeric" min="1" max="60" step="1" value="10" />
              </div>
              <label class="calc-check" data-show-for="escada" hidden>
                <input type="checkbox" name="espelho" checked />
                <span>Incluir espelho (parte vertical do degrau)</span>
              </label>
            </div>
            <figure class="calc-howto">
              <svg viewBox="0 0 220 130" role="img" aria-label="Como medir a peça" data-howto="planta">
                <rect x="30" y="24" width="150" height="62" rx="2" class="howto-body" />
                <path d="M30 100h150M30 95v10M180 95v10" class="howto-dim" />
                <path d="M196 24v62M191 24h10M191 86h10" class="howto-dim" />
                <text x="105" y="118" text-anchor="middle" class="howto-txt">comprimento</text>
                <text x="208" y="58" text-anchor="middle" class="howto-txt" transform="rotate(90 208 58)">largura</text>
              </svg>
              <svg viewBox="0 0 220 130" role="img" aria-label="Como medir a escada" data-howto="escada" hidden>
                <path d="M20 100h40V82h40V64h40V46h40V28h20v72z" class="howto-body" />
                <path d="M20 112h180M20 107v10M200 107v10" class="howto-dim" />
                <text x="110" y="126" text-anchor="middle" class="howto-txt">largura da escada</text>
                <text x="64" y="40" class="howto-txt">cada degrau conta</text>
              </svg>
              <figcaption data-calc-ajuda>Meça o comprimento ao longo da parede, de ponta a ponta.</figcaption>
            </figure>
          </div>
        </fieldset>

        <!-- 3. MATERIAL -->
        <fieldset class="calc-step" data-step="2">
          <legend class="calc-legend"><span class="calc-legend-n">3</span>Material</legend>
          <div class="calc-chips" role="group" aria-label="Filtrar materiais" data-calc-chips>
            <button type="button" class="calc-chip" data-cat="todos" aria-pressed="true">Todos</button>
            {CATEGORIAS.map((c) => <button type="button" class="calc-chip" data-cat={c.id} aria-pressed="false">{c.nome}</button>)}
          </div>
          <div class="calc-materials" role="radiogroup" aria-label="Material">
            {
              MATERIAIS.map((m, i) => (
                <label class="calc-mat" data-mat-cat={m.categoria}>
                  <input type="radio" name="material" value={m.id} checked={i === 0} class="sr-only" />
                  <span class="calc-mat-card">
                    <span class="calc-mat-tex" style={`background-image:url(/tex/${m.id}.svg)`} />
                    <span class="calc-mat-name">{m.nome}</span>
                    <span class="calc-mat-price">R$ {moeda(m.preco.min)}–{moeda(m.preco.max)}/m²</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- 4. ACABAMENTOS -->
        <fieldset class="calc-step" data-step="3">
          <legend class="calc-legend"><span class="calc-legend-n">4</span>Acabamentos <small>(opcionais)</small></legend>
          <div class="calc-opts">
            <div class="calc-opt" data-opt="borda">
              <p class="calc-opt-title" id="lbl-borda">Tipo de borda</p>
              <div class="calc-seg" role="radiogroup" aria-labelledby="lbl-borda">
                {
                  Object.entries(BORDAS).map(([id, b], i) => (
                    <label>
                      <input type="radio" name="borda" value={id} checked={i === 0} class="sr-only" />
                      <span>{b.nome}</span>
                    </label>
                  ))
                }
              </div>
            </div>
            <div class="calc-opt" data-opt="saia">
              <label class="calc-opt-title" for="calc-saia">Saia (frente da peça)</label>
              <select id="calc-saia" name="saia">
                <option value="0">Sem saia</option>
                {[2, 4, 6, 8, ALTURA_SAIA.max].filter((v, i, a) => a.indexOf(v) === i).map((v) => <option value={v}>{v} cm de altura</option>)}
              </select>
            </div>
            <div class="calc-opt" data-opt="frontao">
              <label class="calc-opt-title" for="calc-frontao">Frontão (parede do fundo)</label>
              <select id="calc-frontao" name="frontao">
                <option value="0">Sem frontão</option>
                {[5, 10, 15, 20, 40].map((v) => <option value={v}>{v} cm de altura</option>)}
              </select>
            </div>
            <label class="calc-check" data-opt="rodabanca">
              <input type="checkbox" name="rodabanca" />
              <span>Rodabanca (faixa de 10 cm junto à parede)</span>
            </label>
            <div class="calc-opt" data-opt="cuba">
              <p class="calc-opt-title" id="lbl-cuba">Cuba</p>
              <div class="calc-seg" role="radiogroup" aria-labelledby="lbl-cuba">
                {
                  Object.entries(CUBAS).map(([id, c], i) => (
                    <label>
                      <input type="radio" name="cuba" value={id} checked={i === 0} class="sr-only" />
                      <span>{c.nome}</span>
                    </label>
                  ))
                }
              </div>
            </div>
            <label class="calc-check" data-opt="cooktop">
              <input type="checkbox" name="cooktop" />
              <span>Recorte para cooktop</span>
            </label>
            <p class="calc-note" data-calc-sem-opcoes hidden>Esta peça não leva acabamentos adicionais. Siga para a instalação.</p>
          </div>
        </fieldset>

        <!-- 5. INSTALAÇÃO -->
        <fieldset class="calc-step" data-step="4">
          <legend class="calc-legend"><span class="calc-legend-n">5</span>Instalação</legend>
          <div class="calc-seg calc-seg--wide" role="radiogroup" aria-label="Instalação inclusa">
            <label>
              <input type="radio" name="instalacao" value="sim" checked class="sr-only" />
              <span>Com instalação</span>
            </label>
            <label>
              <input type="radio" name="instalacao" value="nao" class="sr-only" />
              <span>Só a peça</span>
            </label>
          </div>
          <div class="calc-actions">
            <button type="button" class="calc-btn calc-btn--ghost" data-calc-add>
              <Icon name="mais" size={18} /> Adicionar outra peça
            </button>
          </div>
        </fieldset>

        {
          wizard && (
            <div class="calc-nav">
              <button type="button" class="calc-btn calc-btn--ghost" data-calc-prev>
                <Icon name="voltar" size={18} /> Voltar
              </button>
              <button type="button" class="calc-btn" data-calc-next>
                Próximo <Icon name="seta" size={18} />
              </button>
            </div>
          )
        }
      </form>

      <aside class="calc-out" aria-label="Resultado da simulação">
        <div class="calc-viz" data-calc-viz>
          <svg viewBox="0 0 400 270" role="img" aria-label="Desenho da peça em proporção" data-calc-svg></svg>
          <p class="calc-viz-cap" data-calc-viz-cap></p>
        </div>

        <div class="calc-summary">
          <h3 class="calc-summary-title">Resumo</h3>
          <ul class="calc-list" data-calc-list></ul>
          <dl class="calc-totals">
            <div><dt>Área total</dt><dd data-calc-area>0,00 m²</dd></div>
            <div><dt>Com perda de material</dt><dd data-calc-perda>—</dd></div>
            <div><dt>Material</dt><dd data-calc-material>—</dd></div>
            <div><dt>Acabamentos</dt><dd data-calc-acab>—</dd></div>
            <div><dt>Instalação</dt><dd data-calc-inst>—</dd></div>
          </dl>
          <div class="calc-total">
            <span class="calc-total-label">Faixa estimada</span>
            <p class="calc-total-value" aria-hidden="true">
              <span data-calc-min>R$ 0</span><span class="calc-total-sep"> a </span><span data-calc-max>R$ 0</span>
            </p>
            <p class="sr-only" aria-live="polite" data-calc-sr></p>
          </div>
          <p class="calc-aviso">{AVISO_VALORES}</p>
          <a class="calc-btn calc-btn--wa" data-calc-wa href="#" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.100-1.300A10 10 0 1 0 12 2zm0 18.200a8.200 8.200 0 0 1-4.200-1.200l-.3-.2-3 .8.8-2.900-.2-.3A8.200 8.200 0 1 1 12 20.200zm4.500-6.100c-.2-.1-1.500-.7-1.700-.8s-.4-.1-.6.100-.6.800-.8 1-.3.200-.6.100a6.700 6.700 0 0 1-3.300-2.900c-.2-.4.200-.4.700-1.300a.5.500 0 0 0 0-.5l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.300 3 3 0 0 0-.9 2.200 5.300 5.300 0 0 0 1.100 2.800 12 12 0 0 0 4.600 4c1.700.7 2.300.8 3.100.7a2.600 2.600 0 0 0 1.700-1.200 2.100 2.100 0 0 0 .1-1.200c-.1-.1-.3-.2-.6-.3z"/></svg>
            Pedir orçamento pelo WhatsApp
          </a>
        </div>

        <div class="calc-compare" data-calc-compare-wrap>
          <h3 class="calc-summary-title">Compare materiais na mesma medida</h3>
          <div class="calc-compare-grid" data-calc-compare></div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import '../scripts/calculator.ts';
</script>
