---
import { projectUrl, thumbFile } from '../data/portfolio.mjs';
interface Props { niche: any; solo?: boolean }
const { niche, solo = false } = Astro.props;
---
<section class="niche" id={niche.slug} data-niche={niche.slug} style={`--accent:${niche.accent}`} aria-labelledby={`h-${niche.slug}`}>
  <div class="niche-head">
    <div>
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span> grupo / {niche.slug}</p>
      <h2 id={`h-${niche.slug}`}>{niche.name}</h2>
      <p class="blurb">{niche.blurb}</p>
    </div>
    <button type="button" class="btn copy" data-copy={`/${niche.slug}/`}>
      <span aria-hidden="true">⧉</span> Copiar link {solo ? 'desta página' : 'do grupo'}
    </button>
  </div>
  <ul class="cards">
    {niche.projects.map((p: any, i: number) => (
      <li class="card" style={`--d:${(i * 1.7 + 0.4).toFixed(1)}s;--t:${(7 + i * 1.3).toFixed(1)}s;--r:${i % 2 ? -0.35 : 0.35}deg`}>
        <div class="float">
          <article class="win">
            <div class="titlebar">
              <span class="tt"><i class="ico" aria-hidden="true"></i>{niche.slug}\{p.id}.html</span>
              <span class="wbtns" aria-hidden="true"><b>_</b><b>□</b><b>×</b></span>
            </div>
            <div class="body">
              <a class="shot" href={projectUrl(niche, p)} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={`/thumbs/${thumbFile(niche, p)}.webp`} alt="" width="1000" height="563" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <div class="info">
                {p.featured && <span class="badge">★ destaque</span>}
                <h3>{niche.name} · {p.title}</h3>
                <p class="url">{projectUrl(niche, p).replace('https://', '')}</p>
                <div class="actions">
                  <a class="btn primary" href={projectUrl(niche, p)} target="_blank" rel="noopener">Abrir site <span aria-hidden="true">↗</span></a>
                  <button type="button" class="btn" data-copy-abs={projectUrl(niche, p)}><span aria-hidden="true">⧉</span> Copiar</button>
                </div>
              </div>
            </div>
          </article>
        </div>
      </li>
    ))}
  </ul>
</section>
