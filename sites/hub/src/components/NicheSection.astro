---
import { projectUrl, requestUrl, thumbFile } from '../data/portfolio.mjs';
interface Props { niche: any; solo?: boolean; index?: number; total?: number }
const { niche, solo = false, index = 0, total = 1 } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="niche" id={niche.slug} data-niche={niche.slug} style={`--accent:${niche.accent}`} aria-labelledby={`h-${niche.slug}`}>
  <div class="niche-head">
    <div>
      <p class="label eyebrow">{solo ? 'Grupo' : `${pad(index + 1)} / ${pad(total)}`} — {niche.slug}</p>
      <h2 id={`h-${niche.slug}`}>{niche.name}</h2>
      <p class="blurb">{niche.blurb}</p>
    </div>
    <button type="button" class="btn copy" data-copy={`/${niche.slug}/`}>
      Copiar link {solo ? 'desta página' : 'do grupo'}
    </button>
  </div>
  <ul class="cards">
    {niche.projects.map((p: any, i: number) => (
      <li class:list={['card', { featured: p.featured }]} style={`--d:${(i * 1.7 + 0.4).toFixed(1)}s;--t:${(7 + i * 1.3).toFixed(1)}s;--r:${i % 2 ? -0.35 : 0.35}deg`}>
        <div class="float">
          <article class="win">
            <div class="titlebar">
              <span class="tt"><i class="ico" aria-hidden="true"></i>{niche.slug}\{p.id}.html</span>
              <span class="wbtns" aria-hidden="true"><b>_</b><b>□</b><b>×</b></span>
            </div>
            <div class="body">
              <a class="shot" href={projectUrl(niche, p)} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={`/thumbs/${thumbFile(niche, p)}.webp`} alt="" width="1000" height="563" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <div class="info">
                <p class="label">{p.featured ? `${pad(i + 1)} · destaque` : pad(i + 1)}</p>
                <h3>{p.title}</h3>
                <p class="label url">{projectUrl(niche, p).replace('https://', '')}</p>
                <div class="actions">
                  <a class="btn primary" href={projectUrl(niche, p)} target="_blank" rel="noopener">Abrir site →</a>
                  <a class="btn" href={requestUrl(niche, p)} target="_blank" rel="noopener">Pedir este modelo</a>
                </div>
              </div>
            </div>
          </article>
        </div>
      </li>
    ))}
  </ul>
</section>
