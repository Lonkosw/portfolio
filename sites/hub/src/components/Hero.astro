---
import { profile } from '../data/portfolio.mjs';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<header class:list={['hero', { compact }]}>
  <div class="avatar">
    <img src={profile.avatar} alt="" width="132" height="132" decoding="async" />
  </div>
  <h1>{profile.name}</h1>
  <p class="label role"><span class="prompt">C:\&gt;</span> {profile.role}</p>
  <p class="tagline">{profile.tagline}</p>
</header>
