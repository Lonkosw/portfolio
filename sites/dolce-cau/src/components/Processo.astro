---
import { processo } from '../data/site';
---

<section id="processo" class="border-y border-line bg-noir-soft py-24 lg:py-32">
  <div class="shell">
    <div data-centro-mobile class="max-w-2xl">
      <p data-reveal class="eyebrow">{processo.eyebrow}</p>
      <h2
        data-reveal
        data-reveal-delay="0.06"
        class="mt-6 font-[family-name:var(--font-display)] text-[clamp(2rem,5.5vw,3.25rem)] text-cream"
      >
        {processo.titulo}
      </h2>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        processo.etapas.map((etapa, i) => (
          <li
            data-reveal
            data-reveal-delay={i * 0.09}
            class="group relative bg-noir-soft p-7 transition-colors duration-300 hover:bg-surface lg:p-8"
          >
            {/* Era `text-gold/35`, que dava 1.91:1 — abaixo do mínimo de 3:1
                para texto grande. O número não é enfeite: ele diz a ORDEM dos
                passos, e a 35% de opacidade a pessoa mal o enxergava. A 70%
                continua discreto (o destaque é o título do passo) e passa. */}
            <span class="font-[family-name:var(--font-display)] text-4xl text-gold/70 transition-colors duration-300 group-hover:text-gold">
              {etapa.numero}
            </span>
            <h3 class="mt-5 font-[family-name:var(--font-display)] text-xl text-cream">
              {etapa.titulo}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-cream-dim">{etapa.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
