---
import { Image } from 'astro:assets';
import { site, orcamento } from '../data/site';
import { img } from '../lib/images';
import { wa } from '../lib/wa';

const link = wa(site.whatsapp, orcamento.mensagem);
const fundo = img('salao-lustres');
---

<section id="orcamento" class="relative overflow-hidden border-t border-line">
  <!-- Fundo com parallax + escurecimento forte para o texto ficar legível -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div data-parallax="10" class="h-[120%] w-full">
      <Image
        src={fundo}
        alt=""
        widths={[768, 1200, 1600]}
        sizes="100vw"
        loading="lazy"
        class="h-full w-full object-cover opacity-30"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-noir via-noir/85 to-noir"></div>
  </div>

  <div data-centro-mobile class="shell py-28 text-center lg:py-40">
    <p data-reveal class="eyebrow justify-center">{orcamento.eyebrow}</p>

    <h2
      data-reveal
      data-reveal-delay="0.06"
      class="mx-auto mt-6 max-w-[16ch] font-[family-name:var(--font-display)] text-[clamp(2.25rem,7vw,4.5rem)] text-cream"
    >
      {orcamento.titulo}
    </h2>

    <p data-reveal data-reveal-delay="0.12" class="mx-auto mt-6 max-w-[46ch] text-lg text-cream-dim">
      {orcamento.texto}
    </p>

    <div data-reveal data-reveal-delay="0.18" class="mt-10">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        data-magnetic="0.3"
        data-orc-cta
        class="group inline-flex items-center gap-3 rounded-full bg-gold px-9 py-5 text-lg font-medium text-noir transition-colors duration-300 hover:bg-gold-hi"
      >
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.8 14.15c-.25.69-1.43 1.32-1.97 1.37-.5.05-1.15.07-1.85-.12-.43-.13-.98-.31-1.68-.61-2.96-1.28-4.89-4.26-5.04-4.46-.15-.2-1.2-1.6-1.2-3.05s.76-2.16 1.03-2.46c.27-.3.59-.37.78-.37l.56.01c.18 0 .42-.07.66.5.25.6.84 2.06.91 2.21.07.15.12.32.02.52-.1.2-.15.32-.3.49l-.44.51c-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.64-.07.17-.2.74-.86.94-1.16.2-.3.4-.25.66-.15.27.1 1.71.81 2.01.96.3.15.5.22.57.35.07.12.07.72-.18 1.41z"
          ></path>
        </svg>
        {orcamento.cta}
      </a>
    </div>

    <p data-reveal data-reveal-delay="0.24" class="mt-6 text-sm text-cream-dim">
      {site.whatsappExibicao} · {site.horario}
    </p>
  </div>
</section>
