---
/**
 * Simulador de orçamento: botão flutuante + painel lateral.
 *
 * A seleção fica no localStorage do visitante (sem conta, sem servidor) e o
 * botão final abre o WhatsApp da doceria com o pedido já escrito. A lógica
 * toda vive em `src/scripts/orcamento.ts`.
 */
import { brigadeiros, bombons, regras, precoVariavel } from '../data/cardapio';
import { site } from '../data/site';
import { paraNumero } from '../lib/preco';
import { wa } from '../lib/wa';

/**
 * Link de partida do botão de envio.
 *
 * Ele nascia com `href="#"` e só era preenchido pelo script — ou seja, se o
 * JavaScript falhasse (rede ruim, bloqueio, erro), o botão MAIS IMPORTANTE
 * do site não levava a lugar nenhum. A pessoa clicava e nada acontecia.
 *
 * Agora ele já sai do build apontando para o WhatsApp com uma mensagem
 * genérica. O script continua reescrevendo com o pedido montado; a
 * diferença é que o pior caso passou de "botão morto" para "conversa sem o
 * pedido escrito".
 */
const linkPadrao = wa(
  site.whatsapp,
  'Olá, DolceCau! Vim pelo site e gostaria de fazer um orçamento.',
);

const config = {
  doces: [...brigadeiros, ...bombons].map((d) => ({
    slug: d.slug,
    nome: d.nome,
    cento: paraNumero(d.cento),
    unitario: paraNumero(d.unitario),
    variavel: precoVariavel.includes(d.slug),
  })),
  unidadesPorCento: regras.unidadesPorCento,
  minimoCento: regras.minimoPorSaborCento,
  minimoUnitario: regras.minimoPorSaborUnitario,
  whatsapp: site.whatsapp,
  observacao: regras.observacao,
};
---

<script type="application/json" data-orc-config set:html={JSON.stringify(config)} />

<!-- Botão flutuante: só aparece quando há algo selecionado -->
<button
  type="button"
  data-orc-abrir
  hidden
  class="fixed bottom-5 right-5 z-40 flex items-center gap-3 rounded-full bg-gold px-5 py-3.5 text-sm font-medium text-noir shadow-2xl shadow-black/50 transition-colors duration-300 hover:bg-gold-hi"
>
  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M4 5h2l2.4 10.2a2 2 0 0 0 2 1.6h6.9a2 2 0 0 0 2-1.5L21 8H7" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="10.5" cy="20" r="1.2" fill="currentColor"></circle>
    <circle cx="17.5" cy="20" r="1.2" fill="currentColor"></circle>
  </svg>
  <span class="tabular-nums"><span data-orc-contador>0</span> doces</span>
  <span class="h-4 w-px bg-noir/25"></span>
  <span class="tabular-nums">R$ <span data-orc-total>0,00</span></span>
</button>

<dialog
  data-orc-painel
  aria-label="Seu orçamento"
  class="orc-painel m-0 ml-auto h-full max-h-full w-full max-w-md bg-noir-soft p-0 text-cream backdrop:bg-black/70"
>
  <div class="flex h-full flex-col">
    <header class="flex items-center justify-between gap-4 border-b border-line px-6 py-5">
      <div>
        <h2 class="font-[family-name:var(--font-display)] text-2xl">Seu orçamento</h2>
        <p class="mt-1 text-xs text-cream-dim">Fica salvo neste navegador</p>
      </div>
      <button
        type="button"
        data-orc-fechar
        class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-line text-cream-dim transition-colors hover:border-gold hover:text-gold"
        aria-label="Fechar orçamento"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto px-6">
      <p data-orc-vazio class="py-16 text-center text-sm leading-relaxed text-cream-dim">
        Você ainda não escolheu nenhum doce.<br />
        Use o botão <strong class="text-cream">Adicionar</strong> nos sabores do cardápio.
      </p>
      <ul data-orc-lista class="py-2"></ul>
    </div>

    <footer data-orc-resumo hidden class="border-t border-line px-6 py-5">
      <div class="flex items-baseline justify-between gap-4">
        <span class="text-sm text-cream-dim">
          <span data-orc-unidades class="tabular-nums text-cream">0</span> doces
        </span>
        <span class="font-[family-name:var(--font-display)] text-3xl tabular-nums text-gold">
          R$ <span data-orc-valor>0,00</span>
        </span>
      </div>
      <p class="mt-1 text-right text-xs text-cream-dim" data-orc-base></p>

      <ul data-orc-avisos hidden class="mt-4 space-y-2 rounded-xl border border-gold/25 bg-gold/5 p-3 text-xs leading-relaxed text-cream-dim"></ul>

      <p class="mt-4 text-xs leading-relaxed text-cream-dim">
        Estimativa com base na tabela do cardápio. O valor final é confirmado pela
        DolceCau — taxa de entrega, forminhas e datas de evento podem alterar.
      </p>

      <a
        data-orc-enviar
        href={linkPadrao}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex w-full items-center justify-center gap-3 rounded-full bg-gold px-6 py-4 font-medium text-noir transition-colors duration-300 hover:bg-gold-hi"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.8 14.15c-.25.69-1.43 1.32-1.97 1.37-.5.05-1.15.07-1.85-.12-.43-.13-.98-.31-1.68-.61-2.96-1.28-4.89-4.26-5.04-4.46-.15-.2-1.2-1.6-1.2-3.05s.76-2.16 1.03-2.46c.27-.3.59-.37.78-.37l.56.01c.18 0 .42-.07.66.5.25.6.84 2.06.91 2.21.07.15.12.32.02.52-.1.2-.15.32-.3.49l-.44.51c-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.64-.07.17-.2.74-.86.94-1.16.2-.3.4-.25.66-.15.27.1 1.71.81 2.01.96.3.15.5.22.57.35.07.12.07.72-.18 1.41z"
          ></path>
        </svg>
        Enviar pelo WhatsApp
      </a>

      <button
        type="button"
        data-orc-limpar
        class="mt-3 w-full rounded-full px-6 py-2.5 text-sm text-cream-dim transition-colors hover:text-gold"
      >
        Limpar orçamento
      </button>
    </footer>
  </div>
</dialog>

<style is:global>
  /* Painel entra deslizando pela direita. `allow-discrete` deixa a saída
     animar também — sem isso o <dialog> some de uma vez ao fechar. */
  dialog.orc-painel {
    translate: 100% 0;
    transition:
      translate var(--dur-slow) var(--ease-out-expo),
      overlay var(--dur-slow) allow-discrete,
      display var(--dur-slow) allow-discrete;
  }
  dialog.orc-painel[open] {
    translate: 0 0;
  }
  @starting-style {
    dialog.orc-painel[open] {
      translate: 100% 0;
    }
  }

  dialog.orc-painel::backdrop {
    opacity: 0;
    transition:
      opacity var(--dur-base) ease,
      overlay var(--dur-base) allow-discrete,
      display var(--dur-base) allow-discrete;
  }
  dialog.orc-painel[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    dialog.orc-painel[open]::backdrop {
      opacity: 0;
    }
  }

  /* Sem JS os controles não fazem nada — melhor não mostrá-los.
     A classe `js` é posta no <html> pelo script inline do Layout. */
  html:not(.js) [data-orc-controle],
  html:not(.js) [data-orc-abrir] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    dialog.orc-painel,
    dialog.orc-painel::backdrop {
      transition: none;
    }
  }
</style>
