---
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource-variable/inter';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { site } from '../data/site';
import { img } from '../lib/images';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Prévia do link no WhatsApp — o canal real de distribuição deste site.
// 1200x630 é o recorte que WhatsApp e Instagram usam. Numa doceria a foto
// da mesa é o que faz a pessoa clicar; sem isto o link chega como texto.
const preview = await getImage({
  src: img('hero-mesa-lustre'),
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const previewUrl = new URL(preview.src, Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<html lang="pt-BR" class="js-anim scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141010" />

    {/*
      Enquanto for protótipo, fora da busca. Sem isto o demo pode ranquear
      para "dolce cau maringá" e competir com os canais da própria doceria —
      atrapalhar o negócio dela antes mesmo da primeira conversa.
      Vira indexável sozinho quando `demo` virar false em src/data/site.ts.
    */}
    {site.demo && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Roda antes da pintura: sem JS ou com reduced-motion o conteúdo nunca
      // fica preso invisível (o CSS só esconde quando .js-anim está presente).
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.remove('js-anim');
      }
      // Marca que há JS: os controles do orçamento só aparecem com ele.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-gold focus:px-5 focus:py-3 focus:font-medium focus:text-noir"
    >
      Pular para o conteúdo
    </a>

    <slot />

    {/* Cursor decorativo — aria-hidden e pointer-events:none por definição */}
    <div
      data-cursor
      aria-hidden="true"
      class="pointer-events-none fixed left-0 top-0 z-[90] hidden h-3 w-3 rounded-full bg-gold mix-blend-difference [@media(pointer:fine)]:block"
    >
    </div>

    <script>
      import '../scripts/motion';
    </script>

    <style is:global>
      /* Header muda de fundo ao sair do topo */
      [data-header] {
        transition:
          background-color var(--dur-base) var(--ease-out-expo),
          border-color var(--dur-base) var(--ease-out-expo),
          backdrop-filter var(--dur-base) var(--ease-out-expo);
      }
      [data-header].is-stuck {
        background-color: rgb(20 16 16 / 0.82);
        backdrop-filter: blur(14px);
        border-color: var(--color-line);
      }

      /* Leque do menu mobile: abre a partir do canto do botão.
         `visibility` entra na transição para o painel não ficar clicável
         enquanto está invisível — e ainda assim animar a saída. */
      [data-menu-panel] {
        transform-origin: top right;
        opacity: 0;
        transform: scale(0.94) translateY(-8px);
        visibility: hidden;
        pointer-events: none;
        transition:
          opacity var(--dur-base) var(--ease-out-expo),
          transform var(--dur-base) var(--ease-out-expo),
          visibility var(--dur-base);
      }
      [data-menu-panel].is-open {
        opacity: 1;
        transform: none;
        visibility: visible;
        pointer-events: auto;
      }

      /* SplitText precisa que as linhas sejam blocos */
      .split-line {
        display: block;
      }

      /* Marquee contínuo em CSS puro — mais leve que animar via JS */
      @keyframes marquee-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
      .marquee-track {
        animation: marquee-scroll 32s linear infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .marquee-track {
          animation: none;
        }
      }
    </style>
  </body>
</html>
