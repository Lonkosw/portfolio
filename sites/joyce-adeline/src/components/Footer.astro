---
/**
 * Rodapé e seção de contato ao mesmo tempo.
 *
 * DUAS COLUNAS, e não três: o site do Ânima tinha três e a do meio ficava
 * vazia no desktop, porque não havia conteúdo para ela. Aqui não há
 * endereço para publicar (a Joyce só divulga "estúdio próprio"), então
 * inventar uma terceira coluna criaria o mesmo buraco de propósito.
 *
 * O botão de WhatsApp é grande e fica ANTES dos links: este é o fim da
 * página, o lugar onde quem rolou tudo decide chamar ou fechar a aba.
 */
import { site, nav, contato } from '../data/site';
import { wa } from '../lib/wa';

const link = wa(site.whatsapp, contato.mensagem);
---

<footer id="contato" class="border-t border-linha bg-fundo">
  <div class="shell py-16 lg:py-24">
    <div data-reveal data-centro-mobile class="max-w-2xl">
      <p class="eyebrow">{contato.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(1.9rem,6vw,3rem)] text-texto">{contato.titulo}</h2>
      <p class="mt-5 text-[16px] leading-relaxed text-texto-dim">{contato.texto}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={link}
          data-press
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[54px] items-center justify-center gap-2.5 rounded-full bg-btn px-8 text-[15px] font-semibold text-btn-texto transition-colors duration-[var(--dur-fast)] hover:bg-acento-hi"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"
            ></path>
          </svg>
          {site.whatsappExibicao}
        </a>
        <a
          href={site.instagram}
          data-press
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[54px] items-center justify-center rounded-full border border-linha px-8 text-[15px] font-semibold text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento hover:text-acento"
        >
          {site.instagramExibicao}
        </a>
      </div>
    </div>

    <div class="mt-16 grid gap-10 border-t border-linha pt-12 lg:grid-cols-[1.4fr_1fr]">
      <div data-centro-mobile class="max-w-md">
        <p class="flex flex-wrap items-baseline gap-[0.3em] text-[24px] leading-none">
          <span class="font-[family-name:var(--font-display)] text-texto">Joyce Adeline</span>
          <span class="font-[family-name:var(--font-display)] italic text-acento">fotografia</span>
        </p>
        <p class="mt-4 text-[14.5px] leading-relaxed text-texto-dim">{site.descricao}</p>

        {/* Só aparece se o endereço for preenchido — hoje está vazio de
            propósito: a bio dela diz "estúdio próprio" e mais nada, e
            endereço errado manda gestante de sete meses para a rua errada. */}
        {site.endereco && (
          <p class="mt-4 text-[14.5px] leading-snug text-texto-dim">{site.endereco}</p>
        )}
      </div>

      <nav aria-label="Navegação do rodapé" data-centro-mobile>
        <h3 class="text-[12px] font-semibold uppercase tracking-[0.2em] text-acento">Navegar</h3>
        <ul class="-mx-2 mt-3 flex flex-wrap gap-x-1 gap-y-0">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-[44px] min-w-[44px] items-center justify-center px-2 text-[14.5px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:text-texto"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-14 border-t border-linha pt-8">
      <p class="text-center text-[13px] leading-relaxed text-texto-dim">
        {`© ${new Date().getFullYear()} ${site.nomeCompleto} · ${site.cidade} — ${site.estado}`}
      </p>

      {
        site.demo && (
          <p class="mx-auto mt-4 max-w-2xl text-center text-[12.5px] leading-relaxed text-texto-dim">
            Esta página é um <strong class="font-semibold text-texto">protótipo de demonstração</strong> e
            não é o site oficial da {site.nome}. As fotos são dela e foram usadas apenas para
            montar esta proposta.
          </p>
        )
      }
    </div>
  </div>
</footer>
