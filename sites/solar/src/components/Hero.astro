---
import { buildWhatsAppLink } from '../lib/whatsapp';
import type { ClientData } from '../data/types';

interface Props {
  client: ClientData;
}

const { client } = Astro.props;
const link = buildWhatsAppLink(client.whatsapp, `Olá! Vi o site da ${client.businessName} e gostaria de mais informações.`);
---

<section
  class="relative flex min-h-[70vh] items-center justify-center bg-cover bg-center text-center text-white"
  style={{ backgroundImage: `linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url(${client.heroImage})` }}
>
  <div class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-4xl font-bold sm:text-5xl">{client.businessName}</h1>
    <p class="mt-4 text-lg text-white/90">{client.tagline}</p>
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-block rounded-full bg-[var(--color-primary)] px-6 py-3 font-semibold text-white shadow-lg transition hover:opacity-90"
    >
      Falar no WhatsApp
    </a>
  </div>
</section>
