---
import type { ClientData } from '../data/types';

interface Props {
  client: ClientData;
}

const { client } = Astro.props;
---

{
  client.gallery && client.gallery.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-16">
      <h2 class="text-center text-2xl font-bold text-[var(--color-secondary)] sm:text-3xl">
        Galeria
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {client.gallery.map((src) => (
          <img src={src} alt={client.businessName} class="h-48 w-full rounded-xl object-cover" loading="lazy" />
        ))}
      </div>
    </section>
  )
}
