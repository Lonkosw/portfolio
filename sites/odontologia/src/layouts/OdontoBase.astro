---
import type { Clinica } from '../data/odonto-types';
import { flags } from '../data/odonto-config';
import { dadosCliente } from '../lib/clinicas';
import { jsonLd } from '../lib/schema';
import imagens from '../data/imagens.generated.json';

interface Props {
  clinica: Clinica;
  title: string;
  description: string;
  /** Chave da imagem de compartilhamento (og:image). */
  og?: string;
  schemas?: unknown[];
  themeColor: string;
  accent: string;
  m: '1' | '2' | '3';
  cursor?: boolean;
  /** Imagem LCP a pré-carregar (AVIF) — chave do manifesto e atributo sizes. */
  preload?: { img: string; sizes: string };
  /** URLs de fontes woff2 (latin) a pré-carregar. */
  fonts?: string[];
}
const { clinica, title, description, og, schemas = [], themeColor, accent, m, cursor = false, preload, fonts = [] } = Astro.props;
const url = Astro.url.href;
const ogImg = og && (imagens as Record<string, unknown>)[og] ? new URL(`/img/${og}-1280.jpg`, Astro.url).href : undefined;
const pre = preload ? (imagens as Record<string, { widths: number[] }>)[preload.img] : undefined;
const preSrcset = pre ? pre.widths.map((w) => `/img/${preload!.img}-${w}.avif ${w}w`).join(', ') : '';
const fav = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='${themeColor}'/><path d='M20 14c-5 0-9 4-9 10 0 5 2 8 4 13 1 4 .5 14 7 14 4 0 4-9 11-9s7 9 11 9c6.500 0 6-10 7-14 2-5 4-8 4-13 0-6-4-10-9-10-4.500 0-7 2-13 2s-8.500-2-13-2Z' fill='${accent}'/></svg>`)}`;
---

<!doctype html>
<html lang="pt-BR" data-m={m}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {flags.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={fav} />
    <link rel="canonical" href={url} />
    {fonts.map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    {pre && <link rel="preload" as="image" type="image/avif" imagesrcset={preSrcset} imagesizes={preload!.sizes} fetchpriority="high" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={clinica.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {schemas.map((s) => <script type="application/ld+json" set:html={jsonLd(s)} />)}
    <slot name="head" />
  </head>
  <body data-cursor={cursor ? '' : undefined}>
    <slot />
    <script type="application/json" id="clinic-defaults" set:html={jsonLd(dadosCliente(clinica))} />
    <script>
      import '../scripts/fx';
      import { aplicarPersonalizacao } from '../lib/personalizar';
      aplicarPersonalizacao();
    </script>
  </body>
</html>
