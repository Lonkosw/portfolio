---
import { site, orcamento } from '../data/site';
import { wa } from '../lib/wa';

const link = wa(site.whatsapp, orcamento.mensagem);

// Anos calculados no build. Como o site é estático, um deploy novo já traz
// a lista atualizada.
const anoAtual = new Date().getFullYear();
const anos = Array.from({ length: orcamento.anosAFrente + 1 }, (_, i) => anoAtual + i);

const rotuloPilula =
  'flex min-h-[48px] cursor-pointer items-center justify-center rounded-full border border-linha bg-fundo px-5 text-center text-[14.5px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-acento has-[:checked]:font-semibold has-[:checked]:text-btn-texto has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento';

const selectBase =
  'min-h-[52px] w-full appearance-none rounded-xl border border-linha bg-fundo pl-4 pr-11 text-[16px] text-texto transition-colors duration-[var(--dur-fast)] hover:border-acento/60 focus:border-acento';
---

<section
  id="orcamento"
  data-secao-adiavel
  class="border-y border-linha bg-superficie py-24 lg:py-32"
>
  <div class="shell grid items-start gap-14 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
    <div data-reveal data-centro-mobile class="max-w-xl lg:sticky lg:top-28">
      <p class="eyebrow">{orcamento.eyebrow}</p>
      <h2 class="mt-6 text-[clamp(2.1rem,5.5vw,3.4rem)] text-texto">{orcamento.titulo}</h2>
      <p class="mt-6 text-[16.5px] leading-relaxed text-texto-dim">{orcamento.texto}</p>

      <p class="mt-8 flex flex-wrap items-center gap-x-2 text-[15px] leading-relaxed text-texto-dim">
        <span>Prefere falar direto?</span>
        <a
          href={`tel:+${site.whatsapp}`}
          class="inline-flex min-h-[44px] items-center font-semibold text-acento underline decoration-acento/30 underline-offset-4 transition-colors duration-[var(--dur-fast)] hover:text-acento-hi"
        >
          {site.whatsappExibicao}
        </a>
      </p>
    </div>

    {/* ── FERRAMENTA · Montador de orçamento ─────────────────────────
        Existe porque eles NÃO publicam preço. Ver a nota no topo de
        `src/scripts/orcamento.ts`. */}
    <div
      data-reveal
      data-orcamento
      data-orc-whatsapp={site.whatsapp}
      data-orc-padrao={orcamento.mensagem}
      class="rounded-[1.5rem] border border-linha bg-fundo p-6 sm:p-9"
    >
      <div class="grid gap-8">
        {/* Ocasião */}
        <fieldset>
          <legend class="text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Qual é a ocasião
          </legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              orcamento.ocasioes.map((o) => (
                <label class={rotuloPilula}>
                  <input type="radio" name="orc-ocasiao" value={o} data-orc-ocasiao class="sr-only" />
                  {o}
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Itens */}
        <fieldset>
          <legend class="text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Do que você precisa
            <span class="ml-1 font-normal normal-case tracking-normal text-texto-dim">
              (pode marcar mais de um)
            </span>
          </legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              orcamento.itens.map((i) => (
                <label class="flex min-h-[48px] cursor-pointer items-center rounded-full border border-linha bg-fundo px-5 text-[14.5px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:border-acento/60 has-[:checked]:border-acento has-[:checked]:bg-rosa-fundo has-[:checked]:font-semibold has-[:checked]:text-acento has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-acento">
                  <input type="checkbox" value={i} data-orc-item class="sr-only" />
                  {i}
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Convidados */}
        <fieldset>
          <legend class="text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Mais ou menos quantas pessoas
          </legend>
          <div class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
            {
              orcamento.convidados.map((c) => (
                <label class={rotuloPilula}>
                  <input type="radio" name="orc-convidados" value={c} data-orc-convidados class="sr-only" />
                  <span data-tabular>{c}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {/* Data */}
        <div>
          <span class="block text-[13px] font-semibold uppercase tracking-[0.16em] text-acento">
            Para quando
          </span>
          {/*
            Dois <select> em vez de <input type="month">: o `month` não é
            suportado no Safari do iPhone, onde degrada para um campo de
            texto em que a pessoa teria de digitar "2026-10" na mão.
          */}
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="relative">
              <label for="orc-mes" class="sr-only">Mês da festa</label>
              <select id="orc-mes" data-orc-mes class={selectBase}>
                <option value="">Mês</option>
                {
                  orcamento.meses.map((m, i) => (
                    <option value={String(i + 1).padStart(2, '0')}>
                      {m.charAt(0).toUpperCase() + m.slice(1)}
                    </option>
                  ))
                }
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-texto-dim" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>

            <div class="relative">
              <label for="orc-ano" class="sr-only">Ano da festa</label>
              <select id="orc-ano" data-orc-ano class={selectBase}>
                <option value="">Ano</option>
                {anos.map((a) => <option value={String(a)}>{a}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-texto-dim" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
        </div>

        {/* Prévia + envio */}
        <div class="border-t border-linha pt-7">
          <p
            data-orc-resumo
            data-tabular
            aria-live="polite"
            class="mb-3 text-[13.5px] font-semibold text-acento empty:hidden"
          >
          </p>

          {/* A pessoa vê exatamente o que vai enviar antes de sair do site.
              `empty:hidden` some com a caixa enquanto não há escolha. */}
          <p
            data-orc-previa
            aria-live="polite"
            class="mb-5 whitespace-pre-line rounded-xl bg-superficie px-4 py-4 text-[14px] leading-relaxed text-texto-dim empty:hidden"
          >
          </p>

          <a
            href={link}
            data-orc-cta
            data-press
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-[56px] w-full items-center justify-center gap-2.5 rounded-full bg-btn px-6 text-[15px] font-semibold text-btn-texto transition-colors duration-[var(--dur-fast)] hover:bg-acento-hi"
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.03 0 1.2.87 2.35.99 2.51.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"></path>
            </svg>
            {orcamento.cta}
          </a>

          <button
            type="button"
            data-orc-limpar
            data-so-com-js
            class="mt-3 flex min-h-[44px] w-full items-center justify-center rounded-full text-[14px] text-texto-dim transition-colors duration-[var(--dur-fast)] hover:text-texto"
          >
            Limpar
          </button>
        </div>
      </div>

      <p class="mt-8 text-center text-[12.5px] leading-relaxed text-texto-dim">
        Nada é enviado ao sair daqui: a mensagem é montada no seu próprio
        aparelho e só vai quando você tocar em enviar.
      </p>
    </div>
  </div>
</section>
