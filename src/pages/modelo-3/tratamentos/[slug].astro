---
import Layout3 from '../../../layouts/Layout3.astro';
import Picture from '../../../components/shared/Picture.astro';
import Icon from '../../../components/shared/Icon.astro';
import Mascote from '../../../components/m3/Mascote.astro';
import Agendamento from '../../../components/shared/Agendamento.astro';
import TratamentoCorpo from '../../../components/shared/TratamentoCorpo.astro';
import Rodape from '../../../components/shared/Rodape.astro';
import Flutuantes from '../../../components/shared/Flutuantes.astro';
import { clinicas } from '../../../lib/clinicas';
import { tratamentos } from '../../../data/tratamentos';
import { schemaDentist, schemaFaq, schemaTratamento } from '../../../lib/schema';

export function getStaticPaths() {
  return clinicas['modelo-3'].tratamentos.map((slug) => ({ params: { slug } }));
}
const c = clinicas['modelo-3'];
const t = tratamentos[Astro.params.slug!];
const img = c.imagens[t.slug];
---

<Layout3
  clinica={c}
  title={`${t.nome} em ${c.cidade} · ${c.nome}`}
  description={`${t.resumo} Conheça as etapas, o tempo médio e as dúvidas frequentes. Avaliação individual na ${c.nome}.`}
  og={img}
  preload={{ img, sizes: '(min-width:900px) 45vw, 100vw' }}
  schemas={[schemaDentist(c, Astro.url.href, new URL(`/img/${img}-1280.jpg`, Astro.url).href), schemaTratamento(c, t, Astro.url.href), schemaFaq(t.faq)]}
>
  <header class="m3-nav" data-header>
    <div class="wrap">
      <div class="m3-nav-in">
        <a class="m3-logo" href="/modelo-3/" aria-label={`${c.nome}, página inicial`}><Icon name="tooth" size={28} sw={1.8} />{c.nome}</a>
        <div class="m3-nav-cta">
          <a class="btn btn-ghost m3-hide-sm" href="/modelo-3/#tratamentos"><Icon name="back" size={16} />Tratamentos</a>
          <a class="btn btn-primary" href="#agendar">Agendar<span class="m3-hide-sm">&nbsp;avaliação</span></a>
        </div>
      </div>
    </div>
  </header>
  <main>
    <section class="m3-thero">
      <div class="m3-blob m3-blob-a" aria-hidden="true"></div>
      <div class="wrap m3-thero-g">
        <div>
          <p class="eyebrow" data-hero="fade">Tratamento</p>
          <h1 data-hero>{t.nome}</h1>
          <p class="m3-lead" data-hero style="--d:.12s">{c.chamadas[t.slug] ?? t.resumo}</p>
          <ul class="m3-chipsx" data-hero style="--d:.22s"><li><Icon name="clock" size={18} />{t.tempoMedio}</li><li><Icon name="calendar" size={18} />{t.sessoes}</li></ul>
          <div class="m3-hero-cta" data-hero style="--d:.3s"><a class="btn btn-primary" href="#agendar">Agendar avaliação</a></div>
        </div>
        <div class="m3-hero-vis" data-hero="zoom"><div class="m3-photo"><Picture img={img} eager sizes="(min-width:900px) 45vw, 100vw" /></div><div class="m3-mascot" aria-hidden="true"><Mascote /></div></div>
      </div>
    </section>
    <TratamentoCorpo clinica={c} t={t} />
    <Agendamento clinica={c} motivoInicial={t.motivo} titulo={`Agende uma avaliação para ${t.nome.toLowerCase()}`} />
  </main>
  <Rodape clinica={c} />
  <Flutuantes clinica={c} />
</Layout3>
