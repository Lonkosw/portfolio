---
import Landing from '../layouts/Landing.astro';
import Foto from '../components/shared/Foto.astro';
import Icone from '../components/shared/Icone.astro';
import Simulador from '../components/shared/Simulador.astro';
import { empresa2 as e } from '../data/empresa-2';

const links = [
  ['Como funciona', '#como-funciona'],
  ['Simulador', '#simulador'],
  ['Casas atendidas', '#obras'],
  ['Depoimentos', '#depoimentos'],
  ['Dúvidas', '#faq'],
];
const zap = `https://wa.me/${e.whatsapp}?text=${encodeURIComponent(`Olá, ${e.marca}! Quero saber quanto posso economizar com energia solar.`)}`;

const btn = 'inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-7 py-3 text-base font-bold transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[.98]';
const btnVerde = `${btn} bg-destaque text-sobre shadow-[0_8px_0_-2px_#0d5a29] hover:shadow-[0_10px_0_-2px_#0d5a29]`;
const btnAmarelo = `${btn} bg-destaque2 text-texto shadow-[0_8px_0_-2px_#c28f00] hover:shadow-[0_10px_0_-2px_#c28f00]`;
const btnContorno = `${btn} border-2 border-destaque/30 bg-white text-destaque hover:border-destaque`;
const etiqueta = 'inline-block rounded-full bg-destaque/10 px-4 py-1.5 text-sm font-extrabold text-destaque';

const iconesPassos = ['lupa', 'casa', 'documento', 'ferramenta', 'moeda'];
const rotuloTipo: Record<string, string> = { residencial: 'Casas', comercial: 'Comércios', rural: 'Sítios' };
const tiposPresentes = [...new Set(e.portfolio.map((p) => p.tipo))];

// Painéis do telhado da ilustração: 2 fileiras × 4, seguindo a inclinação lateral do telhado
const xl = (y: number) => 130 - (y - 130) * (60 / 70);
const xr = (y: number) => 350 + (y - 130) * (60 / 70);
const paineis: string[] = [];
[[130, 165], [165, 200]].forEach(([y0, y1], r) => {
  for (let c = 0; c < 4; c++) {
    const L0 = xl(y0), R0 = xr(y0), L1 = xl(y1), R1 = xr(y1), g = 3;
    const a = (L: number, R: number, k: number) => L + ((R - L) * k) / 4;
    paineis.push([
      [a(L0, R0, c) + g, y0 + 3], [a(L0, R0, c + 1) - g, y0 + 3], [a(L1, R1, c + 1) - g, y1 - 3], [a(L1, R1, c) + g, y1 - 3],
    ].map((p) => p.map((n) => n.toFixed(1)).join(',')).join(' '));
  }
});
---

<Landing empresa={e}>
  {/* ================= NAVEGAÇÃO ================= */}
  <header class="sticky top-0 z-40 border-b border-linha bg-fundo/90 backdrop-blur-lg">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3 sm:px-6" aria-label="Principal">
      <a href="#topo" class="flex items-center gap-2.5 font-display text-2xl font-semibold text-destaque" aria-label={`${e.nome}, início`}>
        <span class="grid h-10 w-10 place-items-center rounded-full bg-destaque2">
          <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true"><circle cx="16" cy="16" r="6" fill="#1b2b21" /><g stroke="#1b2b21" stroke-width="2.4" stroke-linecap="round"><path d="M16 3.5v3M16 25.5v3M3.5 16h3M25.5 16h3M7.2 7.2l2.1 2.1M22.7 22.7l2.1 2.1M7.2 24.8l2.1-2.1M22.7 9.3l2.1-2.1" /></g></svg>
        </span>
        {e.marca}
      </a>
      <ul class="hidden items-center gap-1 lg:flex">
        {links.map(([r, h]) => <li><a href={h} class="rounded-full px-4 py-2 text-[15px] font-bold text-texto/80 transition-colors hover:bg-destaque/10 hover:text-destaque">{r}</a></li>)}
      </ul>
      <div class="flex items-center gap-2">
        <a href="#simulador" class={`${btnVerde} !min-h-11 !px-5 !py-2 !text-sm`}>Simule sua economia</a>
        <button type="button" data-menu-botao aria-expanded="false" aria-controls="menu-m2" aria-label="Abrir menu" class="grid h-11 w-11 place-items-center rounded-full border-2 border-linha bg-white lg:hidden">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </nav>
    <div id="menu-m2" class="hidden border-t border-linha bg-white px-5 pb-4 lg:hidden">
      <ul>{links.map(([r, h]) => <li><a href={h} class="flex min-h-12 items-center text-lg font-bold">{r}</a></li>)}</ul>
    </div>
  </header>

  <main id="conteudo">
    {/* ================= HERO ================= */}
    <section id="topo" class="relative isolate overflow-hidden">
      <div class="absolute -right-40 -top-40 -z-10 h-[34rem] w-[34rem] rounded-full bg-destaque2/25 blur-3xl" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-16 pt-10 sm:px-6 sm:pt-16 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-14 lg:pb-24">
        <div>
          <p data-reveal class={etiqueta}>☀ {e.hero.etiqueta}</p>
          <h1 data-reveal data-delay="1" class="mt-5 font-display text-[clamp(2.3rem,5.6vw,4.4rem)] font-semibold leading-[1.08] text-texto">
            {e.hero.titulo} <span class="relative whitespace-nowrap text-destaque">{e.hero.destaque}<svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 8c60-8 140-8 294-2" stroke="var(--c-destaque2)" stroke-width="5" stroke-linecap="round" fill="none" /></svg></span>
          </h1>
          <p data-reveal data-delay="2" class="mt-7 max-w-xl text-lg leading-relaxed text-suave sm:text-xl">{e.hero.subtitulo}</p>
          <div data-reveal data-delay="3" class="mt-9 flex flex-wrap gap-4">
            <a href="#simulador" class={btnVerde}>{e.hero.cta}<Icone nome="seta" class="h-5 w-5" /></a>
            <a href={zap} target="_blank" rel="noopener" class={btnContorno}>{e.hero.ctaSecundario}</a>
          </div>
          <div data-reveal data-delay="4" class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-semibold text-suave">
            <span class="flex items-center gap-2"><span class="flex text-destaque2" aria-hidden="true">{Array.from({ length: 5 }, () => <Icone nome="estrela" class="h-5 w-5 fill-current" />)}</span>4,9 no Google</span>
            <span class="flex items-center gap-2"><Icone nome="casa" class="h-5 w-5 text-destaque" />+1.850 famílias atendidas</span>
          </div>
        </div>

        <div data-reveal="zoom" data-delay="2" class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="foto-blob relative aspect-[4/5] overflow-hidden bg-destaque/10">
            <Foto foto={e.hero.foto} prioridade sizes="(min-width:1024px) 42vw, 90vw" class="h-full w-full object-cover" />
          </div>
          <div class="giro absolute -left-4 -top-4 grid h-24 w-24 place-items-center rounded-full bg-destaque2 sm:-left-8 sm:-top-6 sm:h-28 sm:w-28" aria-hidden="true">
            <svg viewBox="0 0 64 64" class="h-16 w-16 sm:h-20 sm:w-20"><circle cx="32" cy="32" r="13" fill="#1b2b21" /><g stroke="#1b2b21" stroke-width="4" stroke-linecap="round"><path d="M32 4v7M32 53v7M4 32h7M53 32h7M12 12l5 5M47 47l5 5M12 52l5-5M47 17l5-5" /></g></svg>
          </div>
          <div class="absolute -bottom-5 right-2 rounded-3xl border-2 border-linha bg-white p-4 shadow-[0_18px_40px_-18px_rgba(20,60,30,.5)] sm:-right-4">
            <p class="text-xs font-bold text-suave">Economia média por mês</p>
            <p class="font-display text-3xl font-semibold text-destaque">R$ 480</p>
          </div>
        </div>
      </div>
    </section>

    {/* ================= NÚMEROS ================= */}
    <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-6 sm:pb-28" aria-label="Números da Lume">
      <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {e.numeros.map((n, i) => (
          <div data-reveal data-delay={i} class:list={['rounded-[2rem] p-6 sm:p-8', i % 2 === 0 ? 'bg-destaque/10' : 'bg-destaque2/25']}>
            <dd class="font-display text-4xl font-semibold text-texto sm:text-5xl">
              <span data-contar={n.valor} data-casas={n.casas ?? 0} data-prefixo={n.prefixo ?? ''} data-sufixo="">{(n.prefixo ?? '') + n.valor.toLocaleString('pt-BR', { minimumFractionDigits: n.casas ?? 0 })}</span>{n.sufixo && <span class="text-[.5em] font-bold opacity-80">{n.sufixo}</span>}
            </dd>
            <dt class="mt-2 text-sm font-bold text-suave sm:text-base">{n.rotulo}</dt>
          </div>
        ))}
      </dl>
    </section>

    {/* ================= CASA QUE ACENDE (assinatura) ================= */}
    <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-6 sm:pb-32" aria-labelledby="casa-m2">
      <div class="grid items-center gap-10 rounded-[2.5rem] bg-white p-6 shadow-[0_30px_80px_-40px_rgba(20,60,30,.45)] sm:p-12 lg:grid-cols-2">
        <div data-reveal>
          <p class={etiqueta}>Como a energia solar funciona</p>
          <h2 id="casa-m2" class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-4xl">De dia o telhado trabalha. À noite, a conta agradece.</h2>
          <p class="mt-4 text-lg leading-relaxed text-suave">Os painéis transformam a luz do sol em energia para a sua casa. O que você não usa vira crédito na distribuidora e abate o consumo da noite.</p>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <div class="rounded-2xl bg-fundo px-5 py-3">
              <p class="text-xs font-bold text-suave">Antes do solar</p>
              <p class="font-display text-2xl font-semibold text-suave line-through decoration-2">R$ 520</p>
            </div>
            <Icone nome="seta" class="h-6 w-6 text-destaque" />
            <div class="rounded-2xl bg-destaque px-5 py-3 text-sobre">
              <p class="text-xs font-bold text-sobre/80">Depois do solar</p>
              <p class="font-display text-2xl font-semibold"><span data-contar="78" data-prefixo="R$ ">R$ 78</span></p>
            </div>
          </div>
          <p class="mt-3 text-xs text-suave">Casa típica com consumo médio de 550 kWh por mês, com taxa mínima e Fio B incluídos.</p>
        </div>

        <div data-reveal="zoom" data-delay="1" class="casa-cena mx-auto w-full max-w-lg">
          <svg viewBox="0 0 480 360" class="h-auto w-full" role="img" aria-label="Ilustração de uma casa com painéis solares no telhado, janelas acesas e sol brilhando">
            <rect x="0" y="0" width="480" height="360" rx="36" fill="#e5f3da" />
            <g transform="translate(402 62)">
              <g class="sol-raios">
                <g stroke="#ffc21a" stroke-width="5" stroke-linecap="round"><path d="M0-44v-14M0 44v14M-44 0h-14M44 0h14M-31-31l-10-10M31 31l10 10M-31 31l-10 10M31-31l10-10" /></g>
              </g>
              <circle r="28" fill="#ffc21a" />
            </g>
            <ellipse cx="240" cy="330" rx="230" ry="40" fill="#b9dd9c" />
            <rect x="90" y="196" width="300" height="130" fill="#fffdf3" stroke="#1b2b21" stroke-width="3" />
            <polygon points="56,200 126,126 354,126 424,200" fill="#cf5f3d" stroke="#1b2b21" stroke-width="3" stroke-linejoin="round" />
            {paineis.map((pts, i) => (
              <polygon class="painel" style={`--n:${i}`} points={pts} fill="#1f4f73" stroke="#cfe6f5" stroke-width="1.5" stroke-linejoin="round" />
            ))}
            <g>
              <circle class="brilho" style="--n:0" cx="145" cy="262" r="46" fill="#ffd45a" />
              <circle class="brilho" style="--n:1" cx="335" cy="262" r="46" fill="#ffd45a" />
              <rect class="janela" style="--n:0" x="120" y="238" width="50" height="48" rx="4" stroke="#1b2b21" stroke-width="3" />
              <rect class="janela" style="--n:1" x="310" y="238" width="50" height="48" rx="4" stroke="#1b2b21" stroke-width="3" />
              <path d="M145 238v48M120 262h50M335 238v48M310 262h50" stroke="#1b2b21" stroke-width="2" />
            </g>
            <rect x="214" y="246" width="52" height="80" rx="6" fill="#15803d" stroke="#1b2b21" stroke-width="3" />
            <circle cx="256" cy="288" r="3.5" fill="#ffc21a" />
            <circle cx="52" cy="312" r="22" fill="#6fb64f" stroke="#1b2b21" stroke-width="3" />
            <circle cx="436" cy="316" r="18" fill="#6fb64f" stroke="#1b2b21" stroke-width="3" />
          </svg>
        </div>
      </div>
    </section>

    {/* ================= COMO FUNCIONA ================= */}
    <section id="como-funciona" class="mx-auto max-w-4xl px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="text-center" data-reveal>
        <p class={etiqueta}>Passo a passo</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">A gente cuida de tudo. Você só acompanha.</h2>
      </div>
      <ol class="relative mt-16 space-y-10 before:absolute before:bottom-6 before:left-[2.1rem] before:top-6 before:w-1 before:rounded-full before:bg-[repeating-linear-gradient(to_bottom,var(--c-destaque)_0_10px,transparent_10px_20px)] before:opacity-30 md:before:left-1/2 md:before:-translate-x-1/2">
        {e.passos.map((p, i) => (
          <li data-reveal={i % 2 ? 'direita' : 'esquerda'} class:list={['relative flex items-start gap-5 md:w-1/2', i % 2 === 1 ? 'md:ml-auto md:flex-row md:pl-12' : 'md:flex-row-reverse md:pr-12 md:text-right']}>
            <span class:list={['relative z-10 grid h-[4.2rem] w-[4.2rem] shrink-0 place-items-center rounded-full border-4 border-fundo text-sobre shadow-[0_8px_20px_-8px_rgba(20,80,40,.6)] md:absolute md:top-0', i % 2 ? 'md:-left-[2.1rem]' : 'md:-right-[2.1rem]', i % 2 ? 'bg-destaque' : 'bg-destaque']}>
              <Icone nome={iconesPassos[i]} class="h-7 w-7" />
            </span>
            <div class="rounded-3xl bg-white p-6 shadow-[0_14px_40px_-24px_rgba(20,60,30,.5)]">
              <p class="text-sm font-extrabold text-destaque">Passo {i + 1} · {p.prazo}</p>
              <h3 class="mt-1 font-display text-2xl font-semibold">{p.titulo}</h3>
              <p class="mt-2 leading-relaxed text-suave">{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* ================= SIMULADOR ================= */}
    <section id="simulador" class="rounded-t-[3rem] bg-destaque/10 py-20 sm:rounded-t-[4rem] sm:py-28">
      <div class="mx-auto max-w-3xl px-5 sm:px-6">
        <div class="text-center" data-reveal>
          <p class={etiqueta}>Simulador</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">{e.simulador.titulo}</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-suave">{e.simulador.texto}</p>
        </div>
        <div class="mt-12" data-reveal data-delay="1">
          <Simulador
            variante="etapas" id="sim2" empresa={e.nome} cidade={e.cidade} whatsapp={e.whatsapp} uf={e.simulador.ufPadrao} conta={e.simulador.contaPadrao}
            tema={{ fundo: '#f1f7ec', card: '#ffffff', borda: '#dbe4d0', texto: '#1b2b21', textoSuave: '#52635a', destaque: '#15803d', destaqueTexto: '#ffffff', linhaSem: '#d93b3b', linhaCom: '#15803d', raio: '2rem', raioBotao: '9999px', fonteDisplay: 'var(--f-display)' }}
          />
        </div>
      </div>
    </section>

    {/* ================= BENEFÍCIOS ================= */}
    <section class="bg-destaque/10 pb-24 sm:pb-32">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-8 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
        <div data-reveal="esquerda" class="relative">
          <Foto foto={e.imagens.cozinha} sizes="(min-width:1024px) 45vw, 100vw" class="aspect-[4/5] w-full rounded-[3rem] object-cover" />
          <div class="absolute -bottom-5 -right-2 rounded-3xl bg-destaque2 px-6 py-4 font-display text-xl font-semibold shadow-lg sm:-right-6">Casa leve,<br />bolso tranquilo</div>
        </div>
        <div>
          <div data-reveal>
            <p class={etiqueta}>Por que escolher energia solar</p>
            <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">Mais sossego para a sua família</h2>
          </div>
          <ul class="mt-10 grid gap-4 sm:grid-cols-2">
            {e.beneficios.map((b, i) => (
              <li data-reveal data-delay={i} class="rounded-[2rem] bg-white p-6 transition-transform duration-300 hover:-translate-y-1">
                <span class:list={['grid h-12 w-12 place-items-center rounded-2xl', i % 2 ? 'bg-destaque2/40 text-texto' : 'bg-destaque/15 text-destaque']}><Icone nome={b.icone} /></span>
                <h3 class="mt-4 font-display text-xl font-semibold">{b.titulo}</h3>
                <p class="mt-2 leading-relaxed text-suave">{b.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ================= PORTFÓLIO ================= */}
    <section id="obras" class="mx-auto max-w-6xl px-5 py-24 sm:px-6 sm:py-32">
      <div class="text-center" data-reveal>
        <p class={etiqueta}>Quem já instalou</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">Casas e negócios que já economizam</h2>
        <div data-filtros="m2" class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="Filtrar por tipo de imóvel">
          <button type="button" data-filtro="todos" aria-pressed="true" class="min-h-11 rounded-full border-2 border-linha bg-white px-6 text-sm font-extrabold aria-pressed:border-destaque aria-pressed:bg-destaque aria-pressed:text-sobre">Todos</button>
          {tiposPresentes.map((t) => (
            <button type="button" data-filtro={t} aria-pressed="false" class="min-h-11 rounded-full border-2 border-linha bg-white px-6 text-sm font-extrabold aria-pressed:border-destaque aria-pressed:bg-destaque aria-pressed:text-sobre">{rotuloTipo[t]}</button>
          ))}
        </div>
      </div>
      <ul data-galeria="m2" class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {e.portfolio.map((p, i) => (
          <li data-tipo={p.tipo} data-reveal data-delay={i % 3} class="group">
            <figure class="h-full overflow-hidden rounded-[2rem] bg-white shadow-[0_14px_40px_-26px_rgba(20,60,30,.6)]">
              <div class="overflow-hidden">
                <Foto foto={p.foto} sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <figcaption class="flex items-center justify-between gap-3 p-5">
                <div>
                  <h3 class="font-display text-lg font-semibold">{p.titulo}</h3>
                  <p class="text-sm text-suave">{p.local}</p>
                </div>
                <span class="shrink-0 rounded-full bg-destaque2/40 px-3 py-1 text-sm font-extrabold">{p.kwp.toLocaleString('pt-BR')} kWp</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    {/* ================= PAGAMENTO ================= */}
    <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="grid items-center gap-10 overflow-hidden rounded-[3rem] bg-destaque2/30 p-6 sm:p-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)]">
        <div data-reveal>
          <Foto foto={e.imagens.chaves} sizes="(min-width:1024px) 33vw, 100vw" class="mb-8 aspect-[4/3] w-full rounded-[2rem] object-cover" />
          <p class={`${etiqueta} !bg-white`}>Formas de pagamento</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-4xl">Uma parcela que cabe no seu bolso</h2>
          <p class="mt-3 text-lg text-texto/75">Muita gente paga o solar com o dinheiro que deixa de gastar na conta de luz.</p>
        </div>
        <ul class="space-y-4">
          {e.pagamento.map((p, i) => (
            <li data-reveal data-delay={i} class="flex items-start gap-5 rounded-[2rem] bg-white p-6">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-destaque text-sobre"><Icone nome={p.icone} class="h-7 w-7" /></span>
              <div>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h3 class="font-display text-xl font-semibold">{p.titulo}</h3>
                  <span class="rounded-full bg-destaque/10 px-3 py-0.5 text-sm font-extrabold text-destaque">{p.detalhe}</span>
                </div>
                <p class="mt-1 leading-relaxed text-suave">{p.texto}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ================= DEPOIMENTOS ================= */}
    <section id="depoimentos" class="mx-auto max-w-6xl px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
        <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <p class={etiqueta}>Depoimentos</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">Quem instalou, recomenda</h2>
          <p class="mt-4 text-lg text-suave">Nota 4,9 no Google, com mais de 380 avaliações de clientes de Minas Gerais.</p>
          <div class="mt-6 rounded-[2rem] bg-destaque p-6 text-sobre">
            <p class="font-display text-5xl font-semibold">4,9</p>
            <p class="mt-1 flex text-destaque2" aria-hidden="true">{Array.from({ length: 5 }, () => <Icone nome="estrela" class="h-6 w-6 fill-current" />)}</p>
            <p class="mt-2 text-sm font-bold text-sobre/90">média de satisfação dos clientes</p>
          </div>
        </div>
        <ul class="grid gap-5 sm:grid-cols-2">
          {e.depoimentos.map((d, i) => (
            <li data-reveal data-delay={i % 2} class:list={['rounded-[2rem] p-6 sm:p-7', i === 0 ? 'bg-white sm:col-span-2 sm:p-9' : 'bg-white']}>
              <p class="flex text-destaque2" role="img" aria-label={`Nota ${d.nota} de 5`}>
                {Array.from({ length: 5 }, (_, k) => <Icone nome="estrela" class={`h-5 w-5 ${k < d.nota ? 'fill-current' : 'opacity-30'}`} />)}
              </p>
              <blockquote class:list={['mt-3 leading-relaxed', i === 0 ? 'font-display text-xl sm:text-2xl' : 'text-[17px]']}>“{d.texto}”</blockquote>
              <footer class="mt-5 flex items-center gap-3">
                <span class:list={['grid h-11 w-11 place-items-center rounded-full font-display text-lg font-semibold', i % 2 ? 'bg-destaque2 text-texto' : 'bg-destaque text-sobre']} aria-hidden="true">{d.nome[0]}</span>
                <div>
                  <p class="font-extrabold">{d.nome}</p>
                  <p class="text-sm text-suave">{d.perfil} · {d.cidade}</p>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ================= GARANTIAS ================= */}
    <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="text-center" data-reveal>
        <p class={etiqueta}>Garantias</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">Tranquilidade por escrito</h2>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-3">
        {e.garantias.map((g, i) => (
          <li data-reveal data-delay={i} class="text-center">
            <span class="mx-auto grid h-36 w-36 place-items-center rounded-full bg-destaque text-sobre shadow-[0_0_0_10px_rgba(21,128,61,.12)]">
              <span class="font-display text-3xl font-semibold leading-none">{g.valor.split(' ')[0]}<br /><span class="text-base">anos</span></span>
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold">{g.titulo}</h3>
            <p class="mx-auto mt-2 max-w-xs leading-relaxed text-suave">{g.texto}</p>
          </li>
        ))}
      </ul>
      <div class="mt-14 grid items-center gap-8 rounded-[2.5rem] bg-white p-6 sm:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-reveal>
        <Foto foto={e.imagens.atendimento} sizes="(min-width:1024px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-[2rem] object-cover" />
        <div>
          <h3 class="font-display text-2xl font-semibold">Segurança em cada etapa</h3>
          <ul class="mt-5 space-y-3">
            {e.certificacoes.map((c) => (
              <li class="flex items-start gap-3 text-lg"><span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-destaque text-sobre"><Icone nome="check" class="h-4 w-4" /></span>{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ================= FAQ ================= */}
    <section id="faq" class="mx-auto max-w-3xl px-5 pb-24 sm:px-6 sm:pb-32">
      <div class="text-center" data-reveal>
        <p class={etiqueta}>Perguntas frequentes</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight sm:text-5xl">Ficou com alguma dúvida?</h2>
      </div>
      <div class="mt-12 space-y-3">
        {e.faq.map((f, i) => (
          <details data-reveal data-delay={i % 2} class="group rounded-[1.75rem] bg-white px-6 open:bg-destaque/10">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-extrabold">
              {f.pergunta}
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-destaque text-sobre transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><Icone nome="mais" class="h-5 w-5" /></span>
            </summary>
            <p class="pb-6 pr-10 text-[17px] leading-relaxed text-suave">{f.resposta}</p>
          </details>
        ))}
      </div>
    </section>

    {/* ================= CTA FINAL ================= */}
    <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-6">
      <div class="relative isolate overflow-hidden rounded-[3rem] bg-destaque px-6 py-16 text-center text-sobre sm:px-16 sm:py-24" data-reveal="zoom">
        <div class="giro-lento absolute -right-24 -top-24 -z-10 h-80 w-80 opacity-30" aria-hidden="true">
          <svg viewBox="-100 -100 200 200"><circle r="38" fill="#ffc21a" /><g stroke="#ffc21a" stroke-width="9" stroke-linecap="round"><path d="M0-56v-34M0 56v34M-56 0h-34M56 0h34M-40-40l-24-24M40 40l24 24M-40 40l-24 24M40-40l24-24" /></g></svg>
        </div>
        <h2 class="mx-auto max-w-2xl font-display text-3xl font-semibold leading-tight sm:text-5xl">{e.ctaFinal.titulo}</h2>
        <p class="mx-auto mt-5 max-w-xl text-lg text-sobre/90">{e.ctaFinal.texto}</p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <a href={zap} target="_blank" rel="noopener" class={btnAmarelo}>{e.ctaFinal.botao}</a>
          <a href="#simulador" class={`${btn} border-2 border-white/60 text-sobre hover:bg-white/10`}>Refazer a simulação</a>
        </div>
      </div>
    </section>
  </main>

  {/* ================= RODAPÉ ================= */}
  <footer class="bg-texto text-fundo">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-6 md:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)]">
      <div>
        <p class="font-display text-3xl font-semibold text-destaque2">{e.nome}</p>
        <p class="mt-3 max-w-sm leading-relaxed text-fundo/75">{e.slogan}</p>
      </div>
      <address class="space-y-2 not-italic text-fundo/80">
        <p class="flex gap-2"><Icone nome="pin" class="mt-1 h-5 w-5 shrink-0 text-destaque2" />{e.endereco.rua}, {e.endereco.bairro}<br />{e.cidade}/{e.uf} · CEP {e.endereco.cep}</p>
        <p class="flex gap-2"><Icone nome="telefone" class="mt-1 h-5 w-5 shrink-0 text-destaque2" /><a href={`tel:+55${e.telefone.replace(/\D/g, '')}`} class="hover:text-white">{e.telefone}</a></p>
        <p><a href={`mailto:${e.email}`} class="hover:text-white">{e.email}</a></p>
        <p>{e.horario}</p>
      </address>
      <div class="text-fundo/80">
        <p class="font-display text-lg font-semibold text-fundo">Siga a Lume</p>
        <p class="mt-2"><a href={`https://instagram.com/${e.instagram.replace('@', '')}`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center hover:text-white">Instagram {e.instagram}</a></p>
      </div>
    </div>
    <p class="border-t border-fundo/15 px-5 py-6 text-center text-sm text-fundo/60">© <span data-ano>{new Date().getFullYear()}</span> {e.nome}. Todos os direitos reservados.</p>
  </footer>
</Landing>

<style is:global>
  .foto-blob { border-radius: 62% 38% 46% 54% / 48% 56% 44% 52%; }
  @keyframes gira { to { transform: rotate(360deg); } }
  .giro { animation: gira 40s linear infinite; }
  .giro-lento { animation: gira 70s linear infinite; }

  /* Assinatura: os painéis viram um a um, as janelas acendem e o sol gira */
  .casa-cena .painel { transform-box: fill-box; transform-origin: 50% 0; transform: scaleY(0); opacity: 0; }
  .casa-cena.is-in .painel { animation: painel-vira .7s cubic-bezier(.3, 1.5, .5, 1) forwards; animation-delay: calc(500ms + var(--n) * 140ms); }
  @keyframes painel-vira { from { transform: scaleY(0); opacity: 0; } to { transform: scaleY(1); opacity: 1; } }
  .casa-cena .janela { fill: #cdd8c6; transition: fill .7s ease calc(2s + var(--n) * 400ms); }
  .casa-cena.is-in .janela { fill: #ffd45a; }
  .casa-cena .brilho { opacity: 0; transition: opacity .9s ease calc(2s + var(--n) * 400ms); }
  .casa-cena.is-in .brilho { opacity: .35; }
  .casa-cena .sol-raios { animation: gira 24s linear infinite; }
  @media (prefers-reduced-motion: reduce) {
    .giro, .giro-lento, .casa-cena .sol-raios { animation: none; }
    .casa-cena .painel { transform: none; opacity: 1; animation: none; }
    .casa-cena .janela { fill: #ffd45a; }
    .casa-cena .brilho { opacity: .35; }
  }
</style>
