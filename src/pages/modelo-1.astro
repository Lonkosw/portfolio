---
import Landing from '../layouts/Landing.astro';
import Foto from '../components/shared/Foto.astro';
import Icone from '../components/shared/Icone.astro';
import Simulador from '../components/shared/Simulador.astro';
import { empresa1 as e } from '../data/empresa-1';

const links = [
  ['Como funciona', '#como-funciona'],
  ['Simulador', '#simulador'],
  ['Obras', '#obras'],
  ['Depoimentos', '#depoimentos'],
  ['Dúvidas', '#faq'],
];
const zap = `https://wa.me/${e.whatsapp}?text=${encodeURIComponent(`Olá, ${e.marca}! Quero um orçamento de energia solar.`)}`;

const btn = 'inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-7 py-3 text-sm font-bold transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-[.98]';
const btnPrimario = `${btn} bg-gradient-to-r from-destaque to-destaque2 text-sobre shadow-[0_10px_40px_-10px_rgba(255,140,30,.7)]`;
const btnVazado = `${btn} border border-linha bg-white/[.05] text-texto backdrop-blur hover:border-destaque`;
const vidro = 'rounded-3xl border border-linha bg-white/[.05] backdrop-blur-xl';

// Geração média mensal de um sistema de 6 kWp em SP (kWh), com sazonalidade
const meses = [['J', 760], ['F', 720], ['M', 700], ['A', 640], ['M', 560], ['J', 520], ['J', 560], ['A', 640], ['S', 640], ['O', 710], ['N', 730], ['D', 770]] as [string, number][];

const tiposPresentes = [...new Set(e.portfolio.map((p) => p.tipo))];
const rotuloTipo: Record<string, string> = { residencial: 'Residencial', comercial: 'Comercial', rural: 'Rural' };
const km = (v: number) => (v >= 1000 ? `${(v / 1000).toLocaleString('pt-BR')} MWp` : `${v.toLocaleString('pt-BR')} kWp`);
---

<Landing empresa={e}>
  {/* ================= NAVEGAÇÃO ================= */}
  <header class="fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-6 sm:pt-4">
    <nav class={`${vidro} mx-auto flex max-w-6xl items-center justify-between gap-3 !rounded-full px-4 py-2 pl-5 shadow-[0_8px_40px_-12px_rgba(0,0,0,.6)]`} aria-label="Principal">
      <a href="#topo" class="flex items-center gap-2 font-display text-lg font-extrabold tracking-tight" aria-label={`${e.nome}, início`}>
        <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true"><circle cx="16" cy="16" r="6.5" fill="var(--c-destaque)" /><g stroke="var(--c-destaque)" stroke-width="2.4" stroke-linecap="round"><path d="M16 3.5v3M16 25.5v3M3.5 16h3M25.5 16h3M7.2 7.2l2.1 2.1M22.7 22.7l2.1 2.1M7.2 24.8l2.1-2.1M22.7 9.3l2.1-2.1" /></g></svg>
        {e.marca}
      </a>
      <ul class="hidden items-center gap-1 lg:flex">
        {links.map(([r, h]) => <li><a href={h} class="rounded-full px-4 py-2 text-sm font-medium text-suave transition-colors hover:bg-white/10 hover:text-texto">{r}</a></li>)}
      </ul>
      <div class="flex items-center gap-2">
        <a href="#simulador" class={`${btnPrimario} !min-h-11 !px-5`}>Simule sua economia</a>
        <button type="button" data-menu-botao aria-expanded="false" aria-controls="menu-m1" aria-label="Abrir menu" class="grid h-11 w-11 place-items-center rounded-full border border-linha lg:hidden">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </nav>
    <div id="menu-m1" class={`${vidro} mx-auto mt-2 hidden max-w-6xl p-3 lg:hidden`}>
      <ul>
        {links.map(([r, h]) => <li><a href={h} class="flex min-h-12 items-center rounded-2xl px-4 text-base font-semibold hover:bg-white/10">{r}</a></li>)}
      </ul>
    </div>
  </header>

  <main id="conteudo">
    {/* ================= HERO ================= */}
    <section id="topo" data-usa-rolagem class="relative isolate flex min-h-[100svh] items-center overflow-hidden pb-16 pt-28 sm:pt-32">
      <div class="absolute inset-0 -z-20">
        <div data-paralaxe="0.18" class="absolute -inset-y-16 inset-x-0 will-change-transform">
          <Foto foto={e.hero.foto} prioridade sizes="100vw" class="h-full w-full object-cover object-[28%_center]" />
        </div>
      </div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-fundo via-fundo/85 to-fundo/20 lg:via-fundo/60"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-fundo to-transparent"></div>

      {/* Assinatura: sol nascendo e raios que giram com a rolagem */}
      <div class="sol-nasce pointer-events-none absolute -bottom-[34rem] -right-[26rem] -z-10 h-[56rem] w-[56rem] sm:-right-[18rem] lg:-right-[8rem]" aria-hidden="true">
        <div class="raios absolute inset-0"></div>
        <div class="absolute inset-[31%] rounded-full bg-[radial-gradient(circle,#ffe39a_0%,#ffb020_45%,rgba(255,107,44,0)_72%)]"></div>
      </div>

      <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-5 sm:px-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <div>
          <p data-reveal class={`${vidro} inline-flex items-center gap-2 !rounded-full px-4 py-2 text-xs font-bold uppercase tracking-[.14em] text-destaque`}>
            <span class="h-2 w-2 rounded-full bg-destaque"></span>{e.hero.etiqueta}
          </p>
          <h1 data-reveal data-delay="1" class="mt-6 font-display text-[clamp(2.4rem,6.2vw,5rem)] font-extrabold leading-[1.02] tracking-[-0.03em]">
            {e.hero.titulo}
            <span class="bg-gradient-to-r from-destaque via-[#ffcf5a] to-destaque2 bg-clip-text text-transparent"> {e.hero.destaque}</span>
          </h1>
          <p data-reveal data-delay="2" class="mt-6 max-w-xl text-lg leading-relaxed text-suave">{e.hero.subtitulo}</p>
          <div data-reveal data-delay="3" class="mt-9 flex flex-wrap gap-3">
            <a href="#simulador" class={btnPrimario}>{e.hero.cta}<Icone nome="seta" class="h-4 w-4" /></a>
            <a href={zap} target="_blank" rel="noopener" class={btnVazado}>{e.hero.ctaSecundario}</a>
          </div>
        </div>

        <aside data-reveal="direita" data-delay="3" class={`${vidro} hidden p-6 lg:block`} aria-label="Geração mensal de um sistema residencial de 6 kWp">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-suave">Sistema de 6 kWp em São Paulo</p>
          <p class="mt-1 font-display text-3xl font-bold">~ 660 kWh <span class="text-base font-medium text-suave">por mês</span></p>
          <div class="mt-6 flex h-36 items-end gap-1.5" role="img" aria-label="Gráfico de barras com a geração estimada em cada mês do ano, maior no verão e menor no inverno">
            {meses.map(([m, v], i) => (
              <div class="flex h-full flex-1 flex-col items-center gap-1.5">
                <div class="flex w-full flex-1 items-end"><div class="barra w-full rounded-t-md bg-gradient-to-t from-destaque2/70 to-destaque" style={`height:${Math.round((v / 770) * 100)}%; --i:${i}`}></div></div>
                <span class="text-[10px] font-semibold text-suave">{m}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 border-t border-linha pt-4 text-sm leading-relaxed text-suave">Estimativa de geração mensal considerando a irradiação média da região e perdas do sistema.</p>
        </aside>
      </div>
    </section>

    {/* ================= NÚMEROS ================= */}
    <section class="relative border-y border-linha bg-superficie/50" aria-label="Números da Aurora">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 lg:grid-cols-4">
        {e.numeros.map((n, i) => (
          <div data-reveal data-delay={i} class:list={['px-5 py-9 sm:px-8 sm:py-12', i % 2 === 1 && 'border-l border-linha', i > 1 && 'border-t border-linha lg:border-t-0', i > 0 && 'lg:border-l lg:border-linha']}>
            <dd class="font-display text-3xl font-extrabold tracking-tight text-destaque sm:text-4xl lg:text-[2.6rem]">
              <span data-contar={n.valor} data-casas={n.casas ?? 0} data-prefixo={n.prefixo ?? ''} data-sufixo="">{(n.prefixo ?? '') + n.valor.toLocaleString('pt-BR', { minimumFractionDigits: n.casas ?? 0 })}</span>{n.sufixo && <span class="text-[.5em] font-bold opacity-80">{n.sufixo}</span>}
            </dd>
            <dt class="mt-2 text-sm font-medium text-suave">{n.rotulo}</dt>
          </div>
        ))}
      </dl>
    </section>

    {/* ================= COMO FUNCIONA ================= */}
    <section id="como-funciona" class="mx-auto max-w-6xl px-5 py-24 sm:px-6 sm:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Como funciona</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">Da simulação à economia, em cinco etapas</h2>
        <p class="mt-4 text-lg text-suave">Você acompanha cada fase, com prazos claros e uma equipe de engenharia responsável pelo projeto.</p>
      </div>
      <ol class="relative mt-16 grid gap-10 lg:grid-cols-5 lg:gap-6">
        <div class="absolute left-[1.35rem] top-2 hidden h-[calc(100%-1rem)] w-px bg-gradient-to-b from-destaque via-destaque/30 to-transparent max-lg:block lg:left-[8%] lg:right-[8%] lg:top-[1.35rem] lg:h-px lg:w-auto lg:bg-gradient-to-r" aria-hidden="true"></div>
        {e.passos.map((p, i) => (
          <li data-reveal data-delay={i} class="relative pl-14 lg:pl-0">
            <span class="absolute left-0 top-0 grid h-11 w-11 place-items-center rounded-full border border-destaque bg-fundo font-display text-base font-extrabold text-destaque shadow-[0_0_30px_-4px_var(--c-destaque)] lg:relative">{i + 1}</span>
            <h3 class="mt-0 font-display text-lg font-bold lg:mt-6">{p.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-suave">{p.texto}</p>
            <span class="mt-3 inline-block rounded-full border border-linha px-3 py-1 text-xs font-semibold text-destaque">{p.prazo}</span>
          </li>
        ))}
      </ol>
    </section>

    {/* ================= SIMULADOR ================= */}
    <section id="simulador" class="relative isolate overflow-hidden py-24 sm:py-32">
      <div class="absolute left-1/2 top-0 -z-10 h-[40rem] w-[70rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(255,176,32,.16),transparent)]" aria-hidden="true"></div>
      <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <div class="max-w-2xl" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Simulador</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">{e.simulador.titulo}</h2>
          <p class="mt-4 text-lg text-suave">{e.simulador.texto}</p>
        </div>
        <div class="mt-12" data-reveal data-delay="1">
          <Simulador
            variante="painel" id="sim1" empresa={e.nome} cidade={e.cidade} whatsapp={e.whatsapp} uf={e.simulador.ufPadrao} conta={e.simulador.contaPadrao}
            tema={{ fundo: '#0b1226', card: 'rgb(255 255 255 / .05)', borda: 'rgb(255 255 255 / .16)', texto: '#eaf0fb', textoSuave: '#a3afc8', destaque: '#ffb020', destaqueTexto: '#1a1100', linhaSem: '#ff6b5a', linhaCom: '#4fd1a5', raio: '1.75rem', raioBotao: '9999px', fonteDisplay: 'var(--f-display)' }}
          />
        </div>
      </div>
    </section>

    {/* ================= BENEFÍCIOS ================= */}
    <section class="mx-auto max-w-6xl px-5 py-24 sm:px-6 sm:py-32" aria-labelledby="beneficios-m1">
      <div class="max-w-2xl" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Benefícios</p>
        <h2 id="beneficios-m1" class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">Mais do que economizar na conta</h2>
      </div>
      <div class="mt-14 grid gap-4 lg:grid-cols-12">
        {e.beneficios.map((b, i) => (
          <article
            data-reveal data-delay={i}
            class:list={[
              'group relative isolate flex min-h-64 flex-col justify-end overflow-hidden p-7 transition-colors hover:border-destaque/60',
              vidro,
              i === 0 && 'lg:col-span-7 lg:min-h-80',
              i === 1 && 'lg:col-span-5',
              i === 2 && 'lg:col-span-5',
              i === 3 && 'lg:col-span-7',
            ]}
          >
            {i === 0 && (
              <>
                <Foto foto={e.imagens.detalhe} sizes="(min-width:1024px) 58vw, 100vw" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 -z-10 bg-gradient-to-t from-fundo via-fundo/70 to-fundo/20"></div>
              </>
            )}
            {i === 3 && <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_85%_15%,rgba(255,176,32,.25),transparent_55%)]"></div>}
            <div class="flex items-start justify-between gap-4">
              <span class="grid h-12 w-12 place-items-center rounded-2xl bg-destaque/15 text-destaque"><Icone nome={b.icone} /></span>
              {b.destaque && <span class="font-display text-2xl font-extrabold text-destaque">{b.destaque}</span>}
            </div>
            <h3 class="mt-auto pt-10 font-display text-xl font-bold">{b.titulo}</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-suave">{b.texto}</p>
          </article>
        ))}
      </div>
    </section>

    {/* ================= PORTFÓLIO ================= */}
    <section id="obras" class="overflow-hidden border-y border-linha bg-superficie/40 py-24 sm:py-32">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 sm:flex-row sm:items-end sm:justify-between sm:px-6" data-reveal>
        <div>
          <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Instalações</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">Projetos entregues</h2>
        </div>
        <div data-filtros="m1" class="flex flex-wrap gap-2" role="group" aria-label="Filtrar instalações por tipo">
          <button type="button" data-filtro="todos" aria-pressed="true" class="min-h-11 rounded-full border border-linha px-5 text-sm font-semibold aria-pressed:border-destaque aria-pressed:bg-destaque aria-pressed:text-sobre">Todas</button>
          {tiposPresentes.map((t) => (
            <button type="button" data-filtro={t} aria-pressed="false" class="min-h-11 rounded-full border border-linha px-5 text-sm font-semibold aria-pressed:border-destaque aria-pressed:bg-destaque aria-pressed:text-sobre">{rotuloTipo[t]}</button>
          ))}
        </div>
      </div>
      <ul data-galeria="m1" class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-6 sm:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))]" style="scrollbar-width:thin;scrollbar-color:var(--c-destaque) transparent">
        {e.portfolio.map((p) => (
          <li data-tipo={p.tipo} class="group w-[78vw] max-w-[26rem] shrink-0 snap-start sm:w-[26rem]">
            <figure class={`${vidro} relative isolate m-0 overflow-hidden`}>
              <Foto foto={p.foto} sizes="(min-width:640px) 26rem, 78vw" class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-fundo via-fundo/10 to-transparent"></div>
              <figcaption class="absolute inset-x-0 bottom-0 p-6">
                <span class="rounded-full bg-destaque px-3 py-1 text-xs font-bold text-sobre">{rotuloTipo[p.tipo]}</span>
                <h3 class="mt-3 font-display text-xl font-bold">{p.titulo}</h3>
                <p class="mt-1 text-sm text-suave">{p.local} · {km(p.kwp)}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    {/* ================= PAGAMENTO ================= */}
    <section class="mx-auto max-w-6xl px-5 py-24 sm:px-6 sm:py-32">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
        <div data-reveal>
          <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Formas de pagamento</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Um investimento que se paga com a própria economia</h2>
          <p class="mt-4 text-suave">Escolha a condição que melhor se encaixa no seu fluxo de caixa. Nós ajudamos a comparar as opções.</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {e.pagamento.map((p, i) => (
            <li data-reveal data-delay={i} class={`${vidro} p-6 transition-colors hover:border-destaque/60`}>
              <div class="flex items-center justify-between gap-3">
                <span class="grid h-11 w-11 place-items-center rounded-xl bg-destaque/15 text-destaque"><Icone nome={p.icone} /></span>
                <span class="rounded-full border border-linha px-3 py-1 text-xs font-semibold text-destaque">{p.detalhe}</span>
              </div>
              <h3 class="mt-5 font-display text-lg font-bold">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-suave">{p.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ================= DEPOIMENTOS ================= */}
    <section id="depoimentos" class="border-t border-linha bg-superficie/40 py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <div class="max-w-2xl" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Depoimentos</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">Quem já gera a própria energia</h2>
        </div>
        <ul class="mt-14 gap-5 [column-fill:_balance] md:columns-2 lg:columns-3">
          {e.depoimentos.map((d, i) => (
            <li data-reveal data-delay={i % 3} class={`${vidro} mb-5 break-inside-avoid p-6`}>
              <p class="flex gap-0.5 text-destaque" role="img" aria-label={`Nota ${d.nota} de 5`}>
                {Array.from({ length: 5 }, (_, k) => <Icone nome="estrela" class={`h-4 w-4 ${k < d.nota ? 'fill-current' : 'opacity-30'}`} />)}
              </p>
              <blockquote class="mt-4 text-[15px] leading-relaxed">“{d.texto}”</blockquote>
              <footer class="mt-5 flex items-center gap-3 border-t border-linha pt-4">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-gradient-to-br from-destaque to-destaque2 font-display text-sm font-extrabold text-sobre" aria-hidden="true">{d.nome[0]}</span>
                <div>
                  <p class="text-sm font-bold">{d.nome}</p>
                  <p class="text-xs text-suave">{d.perfil} · {d.cidade}</p>
                </div>
              </footer>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ================= GARANTIAS ================= */}
    <section class="mx-auto max-w-6xl px-5 py-24 sm:px-6 sm:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Garantias</p>
        <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">Equipamento e obra com garantia por escrito</h2>
      </div>
      <dl class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-linha bg-linha sm:grid-cols-2 lg:grid-cols-4">
        {e.garantias.map((g, i) => (
          <div data-reveal data-delay={i} class="bg-fundo p-7">
            <dt class="garantia-num font-display text-5xl font-extrabold">{g.valor}</dt>
            <dd class="mt-4">
              <p class="font-display font-bold">{g.titulo}</p>
              <p class="mt-1 text-sm leading-relaxed text-suave">{g.texto}</p>
            </dd>
          </div>
        ))}
      </dl>
      <ul class="mt-8 flex flex-wrap gap-3" data-reveal>
        {e.certificacoes.map((c) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-linha px-4 py-2 text-sm text-suave"><Icone nome="check" class="h-4 w-4 text-destaque" />{c}</li>
        ))}
      </ul>
    </section>

    {/* ================= FAQ ================= */}
    <section id="faq" class="border-t border-linha bg-superficie/40 py-24 sm:py-32">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
        <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <p class="text-xs font-bold uppercase tracking-[.16em] text-destaque">Perguntas frequentes</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">As dúvidas mais comuns antes de instalar</h2>
          <p class="mt-4 text-suave">Não achou o que procurava? Fale com a nossa equipe técnica.</p>
          <a href={zap} target="_blank" rel="noopener" class={`${btnVazado} mt-6`}>Tirar dúvidas no WhatsApp</a>
        </div>
        <div class="space-y-3">
          {e.faq.map((f, i) => (
            <details data-reveal data-delay={i % 3} class={`${vidro} group px-6 open:border-destaque/50`}>
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-display text-base font-semibold sm:text-lg">
                {f.pergunta}
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-linha text-destaque transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><Icone nome="mais" class="h-4 w-4" /></span>
              </summary>
              <p class="pb-6 pr-10 leading-relaxed text-suave">{f.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ================= CTA FINAL ================= */}
    <section class="relative isolate overflow-hidden py-28 text-center sm:py-40">
      <Foto foto={e.imagens.fim} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-fundo via-fundo/70 to-fundo/90"></div>
      <div class="mx-auto max-w-3xl px-5 sm:px-6" data-reveal>
        <h2 class="font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl">{e.ctaFinal.titulo}</h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-texto/80">{e.ctaFinal.texto}</p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href={zap} target="_blank" rel="noopener" class={btnPrimario}>{e.ctaFinal.botao}</a>
          <a href="#simulador" class={btnVazado}>Refazer a simulação</a>
        </div>
      </div>
    </section>
  </main>

  {/* ================= RODAPÉ ================= */}
  <footer class="border-t border-linha bg-fundo">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-6 md:grid-cols-[minmax(0,5fr)_minmax(0,4fr)_minmax(0,3fr)]">
      <div>
        <p class="font-display text-2xl font-extrabold">{e.nome}</p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-suave">{e.slogan}</p>
      </div>
      <address class="space-y-2 text-sm not-italic text-suave">
        <p class="flex gap-2"><Icone nome="pin" class="mt-0.5 h-4 w-4 shrink-0 text-destaque" />{e.endereco.rua}, {e.endereco.bairro}<br />{e.cidade}/{e.uf} · CEP {e.endereco.cep}</p>
        <p class="flex gap-2"><Icone nome="telefone" class="mt-0.5 h-4 w-4 shrink-0 text-destaque" /><a href={`tel:+55${e.telefone.replace(/\D/g, '')}`} class="hover:text-texto">{e.telefone}</a></p>
        <p><a href={`mailto:${e.email}`} class="hover:text-texto">{e.email}</a></p>
        <p>{e.horario}</p>
      </address>
      <div class="text-sm text-suave">
        <p class="font-display font-bold text-texto">Redes</p>
        <p class="mt-2"><a href={`https://instagram.com/${e.instagram.replace('@', '')}`} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center hover:text-texto">Instagram {e.instagram}</a></p>
      </div>
    </div>
    <p class="border-t border-linha px-5 py-6 text-center text-xs text-suave">© <span data-ano>{new Date().getFullYear()}</span> {e.nome}. Todos os direitos reservados.</p>
  </footer>
</Landing>

<style is:global>
  /* Sol nascendo: sobe do horizonte uma vez e os raios giram conforme a rolagem */
  @keyframes sol-sobe { from { transform: translate3d(0, 38%, 0); opacity: 0; } to { transform: translate3d(0, 0, 0); opacity: 1; } }
  .sol-nasce { animation: sol-sobe 2.6s cubic-bezier(.2, .7, .2, 1) .2s both; }
  .raios {
    background: repeating-conic-gradient(from 0deg, rgba(255, 176, 32, .26) 0deg 3deg, transparent 3deg 11deg);
    -webkit-mask-image: radial-gradient(closest-side, #000 18%, transparent 78%);
    mask-image: radial-gradient(closest-side, #000 18%, transparent 78%);
    transform: rotate(calc(var(--rolagem, 0) * 0.06deg));
    will-change: transform;
  }
  @keyframes barra-cresce { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .barra { transform-origin: bottom; animation: barra-cresce 1.1s cubic-bezier(.2, .8, .2, 1) calc(0.6s + var(--i) * 70ms) both; }
  .garantia-num { color: transparent; -webkit-text-stroke: 1.5px var(--c-destaque); transition: color .3s ease; }
  div:hover > .garantia-num { color: var(--c-destaque); }
  @media (prefers-reduced-motion: reduce) {
    .sol-nasce, .barra { animation: none; }
    .raios { transform: none; }
  }
</style>
