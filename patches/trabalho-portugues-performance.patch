+/**
+ * Na leitura o 3D fica desfocado atrás do livro HTML: não precisa de 60 fps.
+ * Com frameloop "demand", só redesenhamos (~10 fps) por um instante quando o
+ * tema muda, para a transição de cor terminar; depois a GPU descansa.
+ */
+function ReadingRefresh({ active, theme }: { active: boolean; theme: Theme }) {
+  const invalidate = useThree((s) => s.invalidate);
+  useEffect(() => {
+    if (!active) return;
+    invalidate();
+    const id = setInterval(invalidate, 100);
+    const stop = setTimeout(() => clearInterval(id), 2200);
+    return () => {
+      clearInterval(id);
+      clearTimeout(stop);
+    };
+  }, [active, theme, invalidate]);
+  return null;
+}
+
 export default function Scene3D(props: Props) {
   const [texturesReady, setTexturesReady] = useState(false);
   const onTexturesReady = useMemo(() => () => setTexturesReady(true), []);
